def with_alpha(hexcolor, a):
    h = hexcolor.lstrip("#")
    if len(h) == 3:
        h = h[0]*2 + h[1]*2 + h[2]*2
    r, g, b = h[0:2], h[2:4], h[4:6]
    aa = "%02x" % max(0, min(255, int(round(a * 255))))
    return "#" + r + g + b + aa


def effective_bg(s):
    bg = s.get("bg_image", "")
    if bg:
        return bg.replace("file://", "")
    return active_theme_colors().get("background", "#000000")


def readable_text_color(bg):
    r = g = b = 0
    n = 1
    if bg and (bg.startswith("/") or "://" in bg):
        try:
            from PIL import Image
            with Image.open(os.path.expanduser(bg.replace("file://", ""))) as im:
                im = im.convert("RGB").resize((24, 24))
                px = list(im.getdata())
                r = sum(p[0] for p in px); g = sum(p[1] for p in px); b = sum(p[2] for p in px)
                n = len(px)
        except Exception:
            r = g = b = 128; n = 1
    elif bg and bg.startswith("#"):
        h = bg.lstrip("#")
        if len(h) == 3:
            h = h[0]*2 + h[1]*2 + h[2]*2
        r = int(h[0:2], 16); g = int(h[2:4], 16); b = int(h[4:6], 16); n = 1
    lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / (n * 255.0)
    return "#000000" if lum > 0.5 else "#ffffff"


def effective_clock_format(fmt, show_seconds):
    fmt = (fmt or "hh:mm AP").strip() or "hh:mm AP"
    if not show_seconds:
        return fmt
    if "ss" in fmt:
        return fmt
    if "mm" in fmt:
        return fmt.replace("mm", "mm:ss", 1)
    return fmt + ":ss"


def render_lockview(s):
    def qstr(v):
        return json.dumps(v)
    def qbool(v):
        return "true" if v else "false"
    def qnum(v):
        return str(v)
    bg = s.get("bg_image", "")
    if bg:
        bg = os.path.expanduser(bg)
    avatar = s.get("profile_avatar", "")
    if avatar:
        avatar = os.path.expanduser(avatar)
    mode = s.get("text_color_mode", "theme")
    if mode == "theme":
        lock_text = "Color.lock.text"
        lock_ph = "Color.lock.placeholder"
    else:
        if mode == "custom":
            base = s.get("text_color") or "#ffffff"
        else:
            base = readable_text_color(effective_bg(s))
        lock_text = json.dumps(base)
        lock_ph = json.dumps(with_alpha(base, 0.6))
    sub = {
        "__CLOCK_ENABLED__": qbool(s["clock_enabled"]),
        "__CLOCK_FORMAT__": qstr(effective_clock_format(s.get("clock_format", "hh:mm AP"), s.get("clock_show_seconds", False))),
        "__CLOCK_DATE__": qstr(s["clock_date"]),
        "__CLOCK_SHOW_DATE__": qbool(s["clock_show_date"]),
