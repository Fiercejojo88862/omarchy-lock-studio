def git(repo, *args, timeout=30):
    """Run git inside the project repo. Returns (ok, combined output)."""
    try:
        p = subprocess.run(["git"] + list(args), cwd=repo, capture_output=True,
                           text=True, timeout=timeout)
    except Exception as e:
        return False, str(e)
    return p.returncode == 0, (p.stdout + p.stderr).strip()


def repo_status():
    repo = STUDIO_REPO
    if not os.path.isdir(os.path.join(repo, ".git")):
        return {"ok": False, "error": "no git repo at " + repo}
    ok, branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    if not ok:
        return {"ok": False, "error": branch}
    _, last = git(repo, "log", "-1", "--format=%h %s")
    _, dirty = git(repo, "status", "--porcelain")
    _, remote = git(repo, "remote", "get-url", "origin")
    ahead = ""
    up_ok, up = git(repo, "rev-parse", "--abbrev-ref", "@{u}")
    if up_ok:
        _, ahead = git(repo, "rev-list", "--count", "@{u}..HEAD")
    return {
        "ok": True, "repo": repo, "branch": branch, "last": last,
        "dirty": bool(dirty.strip()), "dirtyFiles": len(dirty.splitlines()),
        "remote": remote, "ahead": ahead.strip(), "upstream": up if up_ok else "",
    }


def sync_repo():
    """Copy this app into its own project repo, commit and push."""
    import shutil
    repo = STUDIO_REPO
    if not os.path.isdir(os.path.join(repo, ".git")):
        return {"ok": False, "error": "no git repo at " + repo}

    dest = os.path.join(repo, STUDIO_SCRIPT_REL)
    shutil.copy2(os.path.realpath(__file__), dest)
    os.chmod(dest, 0o755)

    ok, out = git(repo, "add", "-A", STUDIO_SCRIPT_REL)
    if not ok:
        return {"ok": False, "error": "git add failed: " + out, "files": [STUDIO_SCRIPT_REL]}

    staged, _ = git(repo, "diff", "--cached", "--quiet")
    if staged:
        return {"ok": True, "committed": False, "files": [STUDIO_SCRIPT_REL],
                "detail": "already up to date — nothing changed"}

    msg = "Sync lock studio " + datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    ok, out = git(repo, "commit", "-m", msg)
    if not ok:
        return {"ok": False, "error": "commit failed: " + out, "files": [STUDIO_SCRIPT_REL]}
    _, commit = git(repo, "log", "-1", "--format=%h %s")

    ok, push = git(repo, "push", "origin", "HEAD", timeout=90)
    if not ok:
        return {"ok": False, "files": [STUDIO_SCRIPT_REL], "commit": commit,
                "error": "committed " + commit + " but push failed: " + push}
    return {"ok": True, "committed": True, "commit": commit,
            "files": [STUDIO_SCRIPT_REL], "detail": push.replace("\n", " ") or "pushed"}

