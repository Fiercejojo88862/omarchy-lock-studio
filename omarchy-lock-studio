def find_plugin_dir():
    """Directory of the enabled lock provider, or None.

    Kept as the single lookup the rest of the app uses, so every write lands in
    the plugin the shell actually loads instead of the first clone on disk.
    """
    target, _conflicts, _available = resolve_lock_target()
    return target["dir"] if target else None


def local_plugins():
    """id -> {id, dir, manifest} for every plugin in the user's plugins folder."""
    base = os.path.expanduser("~/.config/omarchy/plugins")
    out = {}
    if not os.path.isdir(base):
        return out
    for name in sorted(os.listdir(base)):
        mpath = os.path.join(base, name, "manifest.json")
        if not os.path.isfile(mpath):
            continue
        try:
            m = json.load(open(mpath))
        except Exception:
            continue
        pid = m.get("id") or name
        out[pid] = {"id": pid, "dir": os.path.join(base, name), "manifest": m}
    return out


_PLUGIN_STATE_CACHE = {"at": 0.0, "map": None}


def plugin_enabled_map(max_age=10):
    """id -> enabled, straight from the shell's own plugin registry.

    None when the command is missing, so callers can fall back instead of
    guessing and writing into a plugin the shell never loads. Cached briefly:
    the UI polls authentication status and every poll would otherwise spawn the
    CLI again.
    """
    now = time.time()
    if (_PLUGIN_STATE_CACHE["map"] is not None
            and now - _PLUGIN_STATE_CACHE["at"] < max_age):
        return _PLUGIN_STATE_CACHE["map"]
    try:
        p = subprocess.run(["omarchy", "plugin", "list", "--json"],
                           capture_output=True, text=True, timeout=15)
        if p.returncode != 0:
            return None
        data = json.loads(p.stdout or "[]")
    except Exception:
        return None
    states = {}
    for row in data if isinstance(data, list) else []:
        if isinstance(row, dict) and row.get("id"):
            states[row["id"]] = bool(row.get("enabled"))
    _PLUGIN_STATE_CACHE.update({"at": now, "map": states})
    return states


def lock_targets():
    """Every lock-screen provider found locally, tagged with enable state.

    A provider is a service plugin that locks the session. That is normally a
    clone of omarchy.lock (omaFace included), but it is also recognised by an
    authentication capability or by talking to WlSessionLock, so a future
    rename of Omarchy's lock plugin does not make this app lose its target.
    Only the user's plugins folder is scanned: that is the one place this app is
    allowed to write.
    """
    states = plugin_enabled_map()
    out = []
    for pid, info in local_plugins().items():
        m = info["manifest"]
        if "service" not in (m.get("kinds") or []):
            continue
        entry = (m.get("entryPoints") or {}).get("service", "")
        service_path = os.path.join(info["dir"], entry) if entry else ""
        omarchy_meta = m.get("omarchy") or {}
        cloned = omarchy_meta.get("clonedFrom", "") or ""
        caps = omarchy_meta.get("capabilities") or []
        lockish = (cloned == "omarchy.lock" or pid == "omarchy.lock"
                   or pid.endswith(".lock") or "authentication" in caps)
        if not lockish and service_path:
            try:
                with open(service_path) as f:
                    lockish = "WlSessionLock" in f.read()
            except Exception:
                lockish = False
        if not lockish:
            continue
        out.append({
            "id": pid,
            "dir": info["dir"],
            "has_service": bool(entry) and os.path.isfile(service_path),
            "face": pid in FACE_PROVIDERS,
            "enabled": states.get(pid, False) if states is not None else True,
        })
    return out


def resolve_lock_target():
    """Pick the provider that owns the lock right now.

    Returns (target, conflicts, available). Only an enabled provider is a valid
    target: writing to a disabled clone is exactly the bug that made Apply look
    like it did nothing. A face-capable provider wins when several are enabled,
    because it is the one adding a lock-time authentication flow.
    """
    targets = lock_targets()
    enabled = [t for t in targets if t["enabled"] and t["has_service"]]
    enabled.sort(key=lambda t: (0 if t["face"] else 1, t["id"]))
    target = enabled[0] if enabled else None
    conflicts = [t for t in enabled[1:]]
    return target, conflicts, targets


