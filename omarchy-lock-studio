def active_theme_colors():
    defaults = {
        "background": "#101019",
        "foreground": "#cdd6f4",
        "accent": "#89b4fa",
        "muted": "#6c7086",
    }
    try:
        name = subprocess.check_output(["omarchy", "theme", "current"]).decode().strip()
    except Exception:
        return defaults
    norm = name.lower().replace(" ", "-")
    candidates = []
    try:
        d = subprocess.check_output(["omarchy", "theme", "dir", name]).decode().strip()
        if d:
            candidates.append(d)
    except Exception:
        pass
    candidates += [
        os.path.expanduser(f"~/.config/omarchy/themes/{norm}/colors.toml"),
        f"/usr/share/omarchy/themes/{norm}/colors.toml",
    ]
    colors = {}
    for c in candidates:
        if os.path.isfile(c):
            colors = parse_colors_toml(c)
            if colors:
                break
    defaults.update(colors)
    return defaults

def parse_colors_toml(path):
    out = {}
    try:
        text = open(path).read()
    except Exception:
        return out
    for key in ("background", "foreground", "accent", "muted", "selection"):
        m = re.search(rf'^\s*{key}\s*=\s*"([^"]+)"', text, re.MULTILINE)
        if m:
            out[key] = m.group(1)
    return out

def playerctl_snapshot():
    try:
        out = subprocess.check_output(
            ["playerctl", "metadata", "--format", "{{title}}|||{{artist}}|||{{mpris:artUrl}}"],
            stderr=subprocess.DEVNULL,
        ).decode().strip()
    except Exception:
        return {"title": "", "artist": "", "art": "", "playing": False}
    parts = out.split("|||")
    title = (parts[0] or "").strip()
    artist = (parts[1] or "").strip()
    art = (parts[2] or "").strip()
    try:
        playing = subprocess.check_output(
            ["playerctl", "status"], stderr=subprocess.DEVNULL
        ).decode().strip().lower() == "playing"
    except Exception:
        playing = bool(title)
    return {"title": title, "artist": artist, "art": art, "playing": playing}

def restart_shell():
    try:
        subprocess.run(["omarchy", "restart", "shell"], check=True,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
        return True, "restarted shell"
    except Exception as e:
        return False, str(e)

def free_port(port):
    """Best-effort: kill whatever process is holding the given TCP port so a new
    instance can take over (prevents a stale server serving old code)."""
    try:
        out = subprocess.check_output(
            ["ss", "-ltnp", "-H", f"sport = :{port}"], stderr=subprocess.DEVNULL
        ).decode()
        for line in out.splitlines():
            m = re.search(r"pid=(\d+)", line)
            if m:
                try:
                    os.kill(int(m.group(1)), 15)
                except Exception:
                    pass
    except Exception:
        pass


def list_files(path):
    """Safe directory listing under the user's home, for the in-page file picker."""
    home = os.path.realpath(os.path.expanduser("~"))
    base = os.path.realpath(os.path.expanduser(path)) if path else home
    if not base.startswith(home):
        base = home
    if not os.path.isdir(base):
        base = home
    entries = []
    try:
        for name in sorted(os.listdir(base)):
            if name.startswith("."):
                continue
            fp = os.path.join(base, name)
            if os.path.isdir(fp):
                entries.append({"name": name, "dir": True, "image": False})
            elif name.lower().endswith((".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg")):
                entries.append({"name": name, "dir": False, "image": True})
    except Exception:
        pass
    parent = os.path.dirname(base)
    return {
        "path": base,
        "parent": parent if parent.startswith(home) else "",
        "entries": entries,
    }

def target_size(kind):
    if kind == "avatar":
        return (512, 512)
    # Background: cover the largest connected monitor.
    try:
        out = subprocess.check_output(["hyprctl", "-j", "monitors"]).decode()
        mons = json.loads(out)
        if isinstance(mons, dict):
            mons = [mons]
        best = [1920, 1080]
        for m in mons:
            w = int(m.get("width", 0) or 0)
            h = int(m.get("height", 0) or 0)
            if w * h > best[0] * best[1]:
                best = [w, h]
        return tuple(best)
    except Exception:
        return (1920, 1080)

def process_image(path, kind):
    """Read an image; if it is smaller than the target for its kind, upscale it
    (LANCZOS) and cache the result in the customizer's assets dir. Returns the
    path to use (original if no upscaling was needed)."""
    src = os.path.realpath(os.path.expanduser(path))
    if not os.path.isfile(src):
        return {"path": path, "upscaled": False, "error": "not found"}
    try:
        from PIL import Image
        with Image.open(src) as im:
            w, h = im.size
    except Exception as e:
        return {"path": path, "upscaled": False, "error": str(e)}
    target = target_size(kind)
    factor = max(target[0] / w, target[1] / h, 1.0)
    if factor <= 1.02:
        return {"path": path, "upscaled": False}
    new_size = (int(round(w * factor)), int(round(h * factor)))
    assets = os.path.join(CONFIG_DIR, "assets")
    os.makedirs(assets, exist_ok=True)
    key = hashlib.sha1((src + str(os.path.getmtime(src))).encode()).hexdigest()[:12]
    out_path = os.path.join(assets, f"{kind}-{key}.png")
    if os.path.isfile(out_path):
        return {"path": out_path, "upscaled": True}
    try:
        with Image.open(src) as im:
            im = im.convert("RGBA") if im.mode in ("RGBA", "LA", "P") else im.convert("RGB")
            im = im.resize(new_size, Image.LANCZOS)
            im.save(out_path)
    except Exception as e:
        return {"path": path, "upscaled": False, "error": str(e)}
    return {"path": out_path, "upscaled": True}

