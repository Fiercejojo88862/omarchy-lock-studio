        "__CLOCK_SCALE__": qnum(s["clock_scale"]),
        "__CLOCK_VPOS__": qstr(s["clock_vpos"]),
        "__FONT_FAMILY__": qstr(s.get("font_family", "")),
        "__CLOCK_FONT__": qstr(s.get("clock_font", "")),
        "__CLOCK_WEIGHT__": CLOCK_WEIGHTS.get(str(s.get("clock_weight", "bold")).lower(), "Font.Bold"),
        "__CLOCK_SPACING__": qnum(float(s.get("clock_spacing", 0) or 0)),
        "__PROFILE_ENABLED__": qbool(s["profile_enabled"]),
        "__PROFILE_NAME__": qstr(s["profile_name"]),
        "__PROFILE_AVATAR__": qstr(avatar),
        "__PROFILE_SHOW_HOST__": qbool(s["profile_show_host"]),
        "__PROFILE_HOST__": qstr(s["profile_host"]),
        "__PROFILE_POS__": qstr(s["profile_pos"]),
        "__SHOW_WELCOME__": qbool(s["show_welcome"]),
        "__WELCOME_TEXT__": qstr(s["welcome_text"]),
        "__VERSES_ENABLED__": qbool(s["verses_enabled"]),
        "__VERSES_POS__": qstr(s["verses_pos"]),
        "__VERSE_WIDTH__": quote_width,
        "__VERSE_OFFSET__": quote_offset,
        "__VERSES_BIG__": qbool(s["verses_big"]),
        "__MEDIA_ENABLED__": qbool(s["media_enabled"]),
        "__MEDIA_POS__": qstr(s["media_pos"]),
        "__BG_IMAGE__": qstr(bg),
        "__BG_BLUR__": qnum(s["bg_blur"]),
        "__BG_DIM__": qnum(s["bg_dim"]),
        "__LOCK_TEXT_COLOR__": lock_text,
        "__LOCK_PLACEHOLDER_COLOR__": lock_ph,
        "__VERSES_LIST__": json.dumps(VERSES, ensure_ascii=False),
