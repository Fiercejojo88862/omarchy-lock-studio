</div>
<div id="zoom">
  <button class="ghost on" id="zoom-fit" type="button">Fit</button>
  <button class="ghost" id="zoom-100" type="button">100%</button>
</div>
<div class="modal" id="picker"><div class="modal-box">
  <div class="modal-head"><span id="picker-path"></span><button class="ghost" id="picker-up" type="button">Up</button><button class="ghost" id="picker-cancel" type="button">Cancel</button></div>
  <div class="modal-list" id="picker-list"></div>
</div></div>
<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);
let S = {};
let THEME = {};
const VERSES = __VERSES_JSON__;

const FIELDS = ["clock_enabled","clock_format","clock_show_seconds","clock_show_date","clock_date","clock_tz","clock_scale","clock_vpos","font_family","clock_font","clock_weight","clock_spacing",
  "profile_enabled","profile_name","profile_avatar","profile_show_host","profile_host","profile_pos",
  "verses_enabled","verses_pos","verses_big","show_welcome","welcome_text","text_color_mode","text_color","media_enabled","media_pos","bg_image","bg_blur","bg_dim"];

function setVal(k,v){ if (typeof v === "boolean") $(k).checked = v; else if ($(k).type === "range" || $(k).type === "text" || $(k).tagName === "SELECT") $(k).value = v; }
function getVal(k){ const el = $(k); if (el.type === "checkbox") return el.checked; if (el.type === "range") return parseFloat(el.value); return el.value; }

function toast(msg){ const t=$("toast"); t.textContent=msg; t.classList.add("show"); setTimeout(()=>t.classList.remove("show"),2200); }

async function api(path, method="GET", body=null){
  const opt = { method, headers: { "Content-Type": "application/json" } };
  if (body) opt.body = JSON.stringify(body);
  const r = await fetch(path, opt);
  return await r.json().catch(()=>({ok:false}));
}

function applyTheme(){
  document.documentElement.style.setProperty("--bg", THEME.background||"#101019");
  document.documentElement.style.setProperty("--fg", THEME.foreground||"#cdd6f4");
  document.documentElement.style.setProperty("--accent", THEME.accent||"#89b4fa");
  document.documentElement.style.setProperty("--muted", THEME.muted||"#6c7086");
}

function pad(n){ return n<10?"0"+n:n; }
function fmtTime(d, f, tz, showSec){
  const sec = showSec || (f && f.indexOf("ss") >= 0);
  try { return new Intl.DateTimeFormat(undefined, { hour:"2-digit", minute:"2-digit", second: sec ? "2-digit" : undefined, hour12: /AP/.test(f)||/a/.test(f), timeZone: tz||undefined }).format(d); }
  catch(e){ return d.toTimeString().slice(0, sec ? 8 : 5); }
}
function fmtDate(d, f, tz){
  try { return new Intl.DateTimeFormat(undefined, { weekday:"short", month:"short", day:"numeric", timeZone: tz||undefined }).format(d); }
  catch(e){ return d.toDateString(); }
}

function renderPreview(){
  const bg = $("pv-bg");
  if (S.bg_image) { bg.style.backgroundImage = "url('"+localImage(S.bg_image)+"')"; bg.style.filter = "blur("+(S.bg_blur*8)+"px)"; }
  else { bg.style.backgroundImage = "none"; bg.style.filter = "blur(8px)"; }
  $("pv-dim").style.opacity = (S.bg_dim===undefined?0.25:S.bg_dim);
  const clock = $("pv-clock");
  if (S.clock_enabled){ clock.style.display="block"; clock.style.top = S.clock_vpos==="top"?"64px":"auto"; clock.style.bottom = S.clock_vpos==="top"?"auto":"64px"; }
  else clock.style.display="none";
  $("pv-time").style.fontSize = Math.round(Style_h()*S.clock_scale)+"px";
  $("pv-date").style.fontSize = Math.round(Style_h()*0.9)+"px";
  $("pv-date").style.display = S.clock_show_date?"block":"none";
  const baseFont = S.font_family || "";
  const clockFont = S.clock_font || baseFont;
  $("screen").style.fontFamily = baseFont;
  $("pv-time").style.fontFamily = clockFont;
  $("pv-date").style.fontFamily = clockFont;
  $("pv-time").style.fontWeight = ({regular:"400",medium:"500",semibold:"600",bold:"700",black:"900"})[S.clock_weight||"bold"] || "700";
  $("pv-time").style.letterSpacing = (S.clock_spacing||0)+"px";

  const prof = $("pv-profile");
  if (S.profile_enabled){ prof.style.display="flex"; placeCorner(prof, S.profile_pos); }
  else prof.style.display="none";
  $("pv-nm").textContent = (S.welcome_text || "Welcome back, {name}").replace("{name}", S.profile_name || "");
  $("pv-nm").style.display = (S.profile_enabled && S.show_welcome) ? "block" : "none";
  $("pv-ho").style.display = S.profile_show_host?"block":"none";
  $("pv-ho").textContent = S.profile_host||"";
  $("pv-nm").style.fontSize = Math.round(Style_h()*0.9)+"px";
  $("pv-ho").style.fontSize = Math.round(Style_h()*0.7)+"px";
  const av = $("pv-av");
  if (S.profile_avatar){ av.innerHTML = '<img src="'+localImage(S.profile_avatar)+'">'; }
  else { av.textContent = (S.profile_name?S.profile_name[0].toUpperCase():"?"); }

  const q = $("pv-quote");
  if (S.verses_enabled){
    const atTop = S.verses_pos === "top";
    const band = p => String(p || "bottom-center").split("-")[0];
    // Same rule as the view: when the profile shares the verse's band, the
    // verse narrows and steps aside instead of running through the name.
    let width = Math.min(PREVIEW.width * 0.7, 900), offset = 0;
    if (S.profile_enabled && band(S.profile_pos) === band(S.verses_pos)){
      width = Math.min(PREVIEW.width * 0.55, 820);
      if (String(S.profile_pos).includes("left")) offset = Math.round(PREVIEW.width * 0.07);
      else if (String(S.profile_pos).includes("right")) offset = -Math.round(PREVIEW.width * 0.07);
    }
    q.style.display = "block";
    q.style.top = atTop ? "56px" : "auto";
    q.style.bottom = atTop ? "auto" : "56px";
    q.style.width = Math.round(width) + "px";
    q.style.transform = "translateX(calc(-50% + " + offset + "px))";
    $("pv-qt").style.fontSize = Math.round(Style_h()*(S.verses_big?1.15:0.8)) + "px";
    $("pv-qa").style.fontSize = Math.round(Style_h()*(S.verses_big?0.85:0.6)) + "px";
  } else q.style.display="none";

  $("pv-pw").style.fontSize = Math.round(Style_h()*1.125) + "px";
  applyLockText();
}

// A page on 127.0.0.1 cannot read file:// URLs, so the server hands the bytes
// over instead: the preview of your picture works in the window and the browser.
function localImage(path){
  return "/api/file?path=" + encodeURIComponent(path) + "&v=" + (window.__imgRev || 0);
}
function withAlphaHex(hex, a){
  hex = hex.replace('#','');
  if (hex.length === 3) hex = hex.split('').map(c=>c+c).join('');
  const r=parseInt(hex.substr(0,2),16), g=parseInt(hex.substr(2,2),16), b=parseInt(hex.substr(4,2),16);
  return `rgba(${r},${g},${b},${a})`;
}
function setTextColors(fg, muted){
  document.documentElement.style.setProperty("--fg", fg);
  document.documentElement.style.setProperty("--muted", muted);
}
function applyLockText(){
  if (S.text_color_mode === "custom"){ const c = S.text_color || "#ffffff"; setTextColors(c, withAlphaHex(c, 0.6)); }
  else if (S.text_color_mode === "auto"){ api("/api/auto-color","POST",S).then(r=>{ if (r.color) setTextColors(r.color, withAlphaHex(r.color, 0.6)); }); }
  else { applyTheme(); }
}

// The real lock screen's size and type scale, sent by the server. The preview
// is laid out at that size and scaled to fit, so a px here is a px there.
let PREVIEW = { width: 1920, height: 1080, heading: 16 };

function Style_h(){ return PREVIEW.heading; }

let ZOOM = "fit";   // "fit" scales the lock to the pane; "100" shows it 1:1

function layoutScreen(){
  const stage = $("stage"), wrap = $("screenWrap"), screen = $("screen");
  stage.classList.toggle("zoomed", ZOOM === "100");
  const k = ZOOM === "100" ? 1 : Math.max(0.05, Math.min(1,
    (stage.clientWidth - 56) / PREVIEW.width,
    (stage.clientHeight - 56) / PREVIEW.height));
  screen.style.width = PREVIEW.width + "px";
  screen.style.height = PREVIEW.height + "px";
  screen.style.transform = "scale(" + k + ")";
  wrap.style.width = Math.round(PREVIEW.width * k) + "px";
  wrap.style.height = Math.round(PREVIEW.height * k) + "px";
}

function placeCorner(el, pos){
  const m="56px";
  el.style.top = pos.includes("top")?m:"auto";
  el.style.bottom = pos.includes("bottom")?m:"auto";
  el.style.left = pos.includes("left")?m:"auto";
  el.style.right = pos.includes("right")?m:"auto";
}

function tick(){
  const d = new Date();
  $("pv-time").textContent = fmtTime(d, S.clock_format, S.clock_tz, S.clock_show_seconds);
  $("pv-date").textContent = fmtDate(d, S.clock_date, S.clock_tz);
}
// The lock view picks the verse whose slot is the hour count since the epoch,
// so the preview uses the same arithmetic and the two never disagree.
function verseForNow(){
  if (!VERSES.length) return null;
  return VERSES[Math.floor(Date.now() / 3600000) % VERSES.length];
}
function tickVerse(){
  const q = verseForNow();
  if (!q) return;
  const sep = q.lastIndexOf(" — ");
  if (sep>=0){ $("pv-qt").textContent = q.slice(0,sep); $("pv-qa").textContent = q.slice(sep+3); }
  else { $("pv-qt").textContent = q; $("pv-qa").textContent=""; }
}
// Re-arm for the next hour boundary rather than polling.
function verseClock(){
  tickVerse();
  setTimeout(verseClock, 3600000 - (Date.now() % 3600000) + 250);
}
async function tickMedia(){
  const m = await api("/api/media");
  const box = $("pv-media");
  if (S.media_enabled && m.title){ box.style.display="flex"; placeCorner(box, S.media_pos);
    $("pv-ti").textContent = m.title; $("pv-ar").textContent = m.artist||"";
    $("pv-ti").style.fontSize = Math.round(Style_h()*0.75)+"px";
    $("pv-ar").style.fontSize = Math.round(Style_h()*0.6)+"px";
    $("pv-art").style.backgroundImage = m.art?("url('"+m.art+"')"):"none";
  } else box.style.display="none";
}

function collect(){ FIELDS.forEach(k=>S[k]=getVal(k)); }

function bindLive(){ FIELDS.forEach(k=>{ const el=$(k); el.addEventListener("input",()=>{ collect(); renderPreview(); }); }); }

let pickerTarget = null;
let pickerCurParent = "";
async function pickerLoad(path){
  const d = await (await fetch("/api/files?path="+encodeURIComponent(path))).json();
  pickerCurParent = d.parent;
  $("picker-path").textContent = d.path;
  const list = $("picker-list"); list.innerHTML = "";
  if (d.parent) {
    const up = document.createElement("div");
    up.className = "pick row";
    up.textContent = "⤴  .. (up)";
    up.onclick = ()=>pickerLoad(d.parent);
    list.appendChild(up);
  }
  d.entries.forEach(e=>{
    const el = document.createElement("div");
    el.className = "pick row" + (e.dir ? " dir" : " img");
    el.textContent = (e.dir ? "▸ " : "🖼 ") + e.name;
    el.onclick = async ()=>{
      if (e.dir) { pickerLoad(d.path + "/" + e.name); return; }
      const kind = (pickerTarget === "bg_image") ? "background" : "avatar";
      let finalPath = d.path + "/" + e.name;
      try {
        const r = await api("/api/process-image", "POST", { path: finalPath, kind: kind });
        if (r && r.path) finalPath = r.path;
        if (r && r.upscaled) toast("Image upscaled for " + kind);
      } catch (err) { /* fall back to original path */ }
      $(pickerTarget).value = finalPath;
      window.__imgRev = Date.now();   // new picture: don't reuse the old bytes
      collect(); renderPreview(); closePicker();
    };
    list.appendChild(el);
  });
}
function openPicker(t){ pickerTarget = t; $("picker").style.display = "flex"; pickerLoad(""); }
function closePicker(){ $("picker").style.display = "none"; }

async function restorePicker(){
  const list = await api("/api/backups");
  if (!list.length){ toast("No backups yet"); return; }
  const pick = prompt("Restore which backup?\n"+list.map((b,i)=>i+": "+b.file).join("\n"), "0");
  if (pick===null) return;
  const b = list[parseInt(pick)];
  if (!b) return;
  const r = await api("/api/restore","POST",{file:b.file});
  toast(r.ok?"Restored "+b.file:(r.error||"restore failed"));
}

async function refreshRepoStatus(){
  const el = $("repo-status");
  if (!el) return;
  const r = await api("/api/repo-status");
  if (!r.ok && r.configured === false){
    const btn = $("repo");
    if (btn && btn.parentElement) btn.parentElement.style.display = "none";
    el.style.display = "none";
    return;
  }
  if (!r.ok){ el.textContent = "project repo: " + (r.error || "unavailable"); return; }
  const bits = [r.branch, r.dirty ? r.dirtyFiles + " uncommitted" : "clean", "last " + r.last];
  if (r.ahead && r.ahead !== "0") bits.push(r.ahead + " ahead");
  el.textContent = "repo: " + r.repo + " · " + bits.join(" · ");
}

async function refreshAuth(){
  const a = await api("/api/auth");
  const face = a.face || {}, fp = a.fingerprint || {}, lock = a.lock || {};

  const setBadge = (id, cls, text) => { const b = $(id); if (!b) return; b.className = "badge " + cls; b.textContent = text; };
  const setDisabled = (id, on) => { const b = $(id); if (b) b.disabled = !!on; };

  // Which plugin actually owns the lock — writes go there and nowhere else.
  if (!lock.enabled) setBadge("lock-badge", "no", "no lock plugin");
  else if (lock.conflicts && lock.conflicts.length) setBadge("lock-badge", "warn", "conflict");
  else if (lock.view && lock.view.generated && lock.view.current) setBadge("lock-badge", "ok", "custom view active");
  else if (lock.view && lock.view.generated) setBadge("lock-badge", "warn", "change pending");
  else setBadge("lock-badge", "warn", "stock view");
  $("lock-desc").textContent = (lock.enabled
    ? "Customizing " + lock.id + (lock.face ? " (face unlock included)" : "") + " · " + lock.dir
    : "—") + ((lock.warnings && lock.warnings.length) ? " · " + lock.warnings.join(" · ") : "");

  // Face
  if (!face.hardware) setBadge("face-badge", "no", "no camera");
  else if (!face.installed) setBadge("face-badge", "no", "not installed");
  else if (face.available) setBadge("face-badge", "ok", "active");
  else if (face.enrolled) setBadge("face-badge", "warn", "enrolled");
  else setBadge("face-badge", "warn", "not enrolled");
  $("face-desc").textContent = face.reason || "—";
  setDisabled("face-enroll", !face.installed);
  setDisabled("face-test", !(face.installed && face.enrolled));
  setDisabled("face-toggle", !(face.installed && face.enrolled));
  setDisabled("face-setup", !face.installed);
  $("face-toggle").textContent = face.lock_enabled ? "Turn off on lock" : "Turn on for lock";

  // Fingerprint
  if (!fp.hardware) setBadge("fp-badge", "no", "no reader");
  else if (fp.available) setBadge("fp-badge", "ok", "active");
  else if (!fp.installed) setBadge("fp-badge", "warn", "not set up");
  else setBadge("fp-badge", "warn", "no prints");
  $("fp-desc").textContent = fp.reason || "—";
  setDisabled("fp-setup", !fp.hardware);
  setDisabled("fp-enroll", !(fp.hardware && fp.installed));
}

async function authAction(component, action){
  const r = await api("/api/auth/action", "POST", { component, action });
  toast(r.ok ? (r.message || "Done") : ("Failed: " + (r.error || "unknown")));
  if (r.ok) setTimeout(refreshAuth, 1200);
}

async function init(){
  const [theme, settings, media, preview] = await Promise.all([
    api("/api/theme"), api("/api/settings"), api("/api/media"), api("/api/preview")]);
  if (preview && preview.width) PREVIEW = preview;
  THEME = theme; S = settings; applyTheme();
  layoutScreen();
  window.addEventListener("resize", layoutScreen);
  $("zoom-fit").onclick = ()=>{ ZOOM = "fit"; $("zoom-fit").classList.add("on"); $("zoom-100").classList.remove("on"); layoutScreen(); };
  $("zoom-100").onclick = ()=>{ ZOOM = "100"; $("zoom-100").classList.add("on"); $("zoom-fit").classList.remove("on"); layoutScreen(); };
  FIELDS.forEach(k=>setVal(k, S[k]));
  renderPreview(); bindLive(); tick(); setInterval(tick,1000);
  refreshRepoStatus();
  refreshAuth(); setInterval(refreshAuth, 15000);
  verseClock();
  tickMedia(); setInterval(tickMedia,2000);

  $("bg_browse").onclick = ()=>openPicker("bg_image");
  $("profile_avatar_browse").onclick = ()=>openPicker("profile_avatar");
  $("picker-cancel").onclick = closePicker;
  $("picker-up").onclick = ()=>pickerLoad(pickerCurParent);
  $("apply").onclick = async ()=>{ collect(); const r=await api("/api/apply","POST",S);
    if (!r.ok){
      let why = r.error || "unknown";
      if (r.rollback) why += " · " + r.rollback;
      toast("Not applied: " + why);
      refreshAuth(); return;
    }
    let msg = "Applied to " + (r.id || "lock");
    if (r.verified === true) msg += ", verified after restart";
    else if (r.restart_error) msg += " · takes effect at next shell start (" + r.restart_error + ")";
    const carried = [].concat(r.added_properties||[], r.added_signals||[], r.added_functions||[]);
    if (carried.length) msg += " · carried " + carried.join(", ");
    if (r.conflicts && r.conflicts.length) msg += " · also enabled: " + r.conflicts.join(", ");
    toast(msg); refreshAuth(); };
  $("save").onclick = async ()=>{ collect(); const r=await api("/api/settings","POST",S); toast(r.ok?"Saved":"Save failed"); };
  $("backup").onclick = async ()=>{ collect(); const r=await api("/api/apply","POST",S); toast(r.ok?"Backed up & applied":"Error"); };
  $("restore").onclick = restorePicker;
  $("repo").onclick = async ()=>{
    toast("Syncing to project repo…");
    const r = await api("/api/sync-repo","POST",{});
    toast(r.ok ? (r.committed ? "Pushed " + r.commit : "Repo already up to date")
               : ("Sync failed: " + (r.error||"unknown")));
    refreshRepoStatus();
  };
