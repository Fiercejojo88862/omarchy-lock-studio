def find_plugin_dir():
    """Locate the user-cloned omarchy.lock plugin (~/.config/omarchy/plugins/*)."""
    base = os.path.expanduser("~/.config/omarchy/plugins")
    if not os.path.isdir(base):
        return None
    for name in os.listdir(base):
        mpath = os.path.join(base, name, "manifest.json")
        if not os.path.isfile(mpath):
            continue
        try:
            m = json.load(open(mpath))
        except Exception:
            continue
        if m.get("omarchy", {}).get("clonedFrom") == "omarchy.lock" or m.get("id", "").endswith(".lock"):
            return os.path.join(base, name)
    return None

def ensure_initial_backup(lockview_path):
    if lockview_path and os.path.isfile(lockview_path) and not os.path.isfile(INITIAL_BACKUP):
        import shutil
        shutil.copy2(lockview_path, INITIAL_BACKUP)

def installed_fonts():
    """Font family names for the Typography datalist, straight from fontconfig."""
    try:
        out = subprocess.run(["fc-list", ":", "family"], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:
        return []
    fams = set()
    for line in out.splitlines():
        for fam in line.split(","):
            fam = fam.strip()
            if fam:
                fams.add(fam)
    return sorted(fams, key=str.lower)


def ensure_face_glyph(plugin_dir):
    """Write the bundled FaceGlyph.qml next to LockView.qml if it is missing."""
    if not plugin_dir:
        return None
    path = os.path.join(plugin_dir, "FaceGlyph.qml")
    try:
        if os.path.isfile(path):
            with open(path) as f:
                if f.read() == FACE_GLYPH_QML:
                    return path
        with open(path, "w") as f:
            f.write(FACE_GLYPH_QML)
        return path
    except Exception:
        return None


def load_settings():
    if os.path.isfile(SETTINGS_PATH):
        try:
            s = json.load(open(SETTINGS_PATH))
            merged = dict(DEFAULT_SETTINGS)
            merged.update(s)
            return merged
        except Exception:
            pass
    return dict(DEFAULT_SETTINGS)

def save_settings(s):
    with open(SETTINGS_PATH, "w") as f:
        json.dump(s, f, indent=2)

def timestamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")

def backup_current(lockview_path, label="auto"):
    if not lockview_path or not os.path.isfile(lockview_path):
        return None
    import shutil
    dest = os.path.join(BACKUP_DIR, f"{label}-{timestamp()}-LockView.qml")
    shutil.copy2(lockview_path, dest)
    return dest

def list_backups():
    out = []
    if os.path.isdir(BACKUP_DIR):
        for fn in sorted(os.listdir(BACKUP_DIR), reverse=True):
            if fn.endswith(".qml"):
                p = os.path.join(BACKUP_DIR, fn)
                out.append({"file": fn, "mtime": os.path.getmtime(p)})
    return out

def restore_backup(filename, lockview_path):
    src = os.path.join(BACKUP_DIR, filename)
    if not os.path.isfile(src):
        return False, "backup not found"
    import shutil
    backup_current(lockview_path, label="pre-restore")
    shutil.copy2(src, lockview_path)
    return restart_shell()


