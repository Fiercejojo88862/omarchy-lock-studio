        with open(view) as f:
            text = f.read()
        mtime = os.path.getmtime(view)
    except Exception:
        return {"generated": False, "current": False, "mtime": 0}
    desired = render_for_target(load_settings(), target["dir"])[0]
    return {"generated": GENERATED_MARKER in text,
            "current": text == desired,
            "mtime": int(mtime)}


def lock_target_status():
    """The target + warnings, for the UI and for --sync output."""
    target, conflicts, available = resolve_lock_target()
    warnings = []
    if target is None:
        if available:
            warnings.append(
                "Every lock provider in ~/.config/omarchy/plugins is disabled — "
                "enable one (omarchy plugin enable " + available[0]["id"] +
                ") or the shell runs its own stock lock.")
        else:
            warnings.append(
                "No lock provider cloned into ~/.config yet — run "
                "`omarchy plugin clone omarchy.lock` (or install omaFace) first.")
    for t in conflicts:
        warnings.append(
            "%s is also an enabled lock service; only one may own the lock. "
            "Disable it with `omarchy plugin disable %s`." % (t["id"], t["id"]))
    return {
        "id": target["id"] if target else "",
        "dir": target["dir"] if target else "",
        "face": bool(target and target["face"]),
        "enabled": bool(target),
        "providers": available,
        "conflicts": [t["id"] for t in conflicts],
        "warnings": warnings,
        "view": view_state(target),
    }

def ensure_initial_backup(lockview_path, label=None):
    """Keep one pristine copy of the provider's own view.

    An Omarchy/omaFace update may rebuild LockView.qml; restoring stock must then
    fall back to the provider's build, never to our generated file. A per-plugin
    copy is used when a label is given, so omaFace and a plain clone do not share
    one "stock" view.
    """
    if label:
        dest = os.path.join(BACKUP_DIR, "stock-%s-LockView.qml" % label)
        if os.path.isfile(dest):
            return dest
        if lockview_path and os.path.isfile(lockview_path):
            with open(lockview_path) as f:
                if GENERATED_MARKER in f.read():
                    return None
            import shutil
            shutil.copy2(lockview_path, dest)
            return dest
        return None
    if lockview_path and os.path.isfile(lockview_path) and not os.path.isfile(INITIAL_BACKUP):
        import shutil
        shutil.copy2(lockview_path, INITIAL_BACKUP)
    return INITIAL_BACKUP


def stock_backup_for(target_dir):
    """The untouched view for this provider, or the legacy shared backup."""
    label = os.path.basename(target_dir.rstrip("/")) if target_dir else ""
    dest = os.path.join(BACKUP_DIR, "stock-%s-LockView.qml" % label)
    if label and os.path.isfile(dest):
        return dest
    return INITIAL_BACKUP if os.path.isfile(INITIAL_BACKUP) else None

def installed_fonts():
    """Font family names for the Typography datalist, straight from fontconfig."""
    try:
        out = subprocess.run(["fc-list", ":", "family"], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:
        return []
    fams = set()
    for line in out.splitlines():
        for fam in line.split(","):
            fam = fam.strip()
            if fam:
                fams.add(fam)
    return sorted(fams, key=str.lower)


def ensure_face_glyph(plugin_dir):
    """Install the studio's own face mark next to LockView.qml.

    The view references `LockStudioFaceGlyph.qml`, a file this app owns, rather
    than the provider's `FaceGlyph.qml`. A provider update may change its own
    component's properties; a customized view that called them would then fail
    to load, so the mark is not shared. The provider's file is left untouched
    for its own (rebuilt) LockView.
    """
    if not plugin_dir:
        return None
    path = os.path.join(plugin_dir, "LockStudioFaceGlyph.qml")
    try:
        existing = ""
        if os.path.isfile(path):
            with open(path) as f:
                existing = f.read()
        if existing != FACE_GLYPH_QML:
            with open(path, "w") as f:
                f.write(FACE_GLYPH_QML)
        return path
    except Exception:
        return None


def load_settings():
    if os.path.isfile(SETTINGS_PATH):
        try:
            s = json.load(open(SETTINGS_PATH))
            merged = dict(DEFAULT_SETTINGS)
            merged.update(s)
            # Older builds rotated a quote list every N seconds; carry the rest
            # of that block over to the verse settings and drop the interval.
            for old, new in (("quotes_enabled", "verses_enabled"),
                             ("quotes_pos", "verses_pos"),
                             ("quotes_big", "verses_big")):
                if old in s:
                    merged[new] = s[old]
                    merged.pop(old, None)
            merged.pop("quote_interval", None)
            return merged
        except Exception:
            pass
    return dict(DEFAULT_SETTINGS)

def save_settings(s):
    with open(SETTINGS_PATH, "w") as f:
        json.dump(s, f, indent=2)

def timestamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")

def backup_current(lockview_path, label="auto"):
    if not lockview_path or not os.path.isfile(lockview_path):
        return None
    import shutil
    dest = os.path.join(BACKUP_DIR, f"{label}-{timestamp()}-LockView.qml")
    shutil.copy2(lockview_path, dest)
    return dest

def list_backups():
    out = []
    if os.path.isdir(BACKUP_DIR):
        for fn in sorted(os.listdir(BACKUP_DIR), reverse=True):
            if fn.endswith(".qml"):
                p = os.path.join(BACKUP_DIR, fn)
                out.append({"file": fn, "mtime": os.path.getmtime(p)})
