  </div>

  <div class="group">
    <h2>Authentication</h2>

    <div class="auth-card">
      <div class="auth-head"><span class="auth-title">Lock screen service</span><span class="badge" id="lock-badge">checking…</span></div>
      <div class="hint" id="lock-desc">—</div>
    </div>

    <div class="auth-card">
      <div class="auth-head"><span class="auth-title">Face Recognition (omaFace)</span><span class="badge" id="face-badge">checking…</span></div>
      <div class="hint" id="face-desc">—</div>
      <div class="btns">
        <button class="ghost" id="face-enroll" type="button">Enroll face</button>
        <button class="ghost" id="face-test" type="button">Test</button>
        <button class="ghost" id="face-toggle" type="button">Toggle on lock</button>
        <button class="ghost" id="face-setup" type="button">Run setup</button>
