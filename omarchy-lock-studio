                        % os.path.basename(target_dir.rstrip("/")))


def install_view(target, text, label="pre-apply"):
    """Atomically install a validated view, keeping one copy that is known good.

    The previous file is always backed up first, and the text must already have
    passed validate_view().
    """
    view = os.path.join(target["dir"], "LockView.qml")
    ensure_initial_backup(view, label=os.path.basename(target["dir"]))
    ensure_face_glyph(target["dir"])
    backup_current(view, label=label)
    tmp = view + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, view)
    return view


def rollback_view(target, reason):
    """Put the last view that loaded back on disk. Returns (ok, detail)."""
    view = os.path.join(target["dir"], "LockView.qml")
    for candidate, name in ((last_good_path(target["dir"]), "last good view"),
                            (stock_backup_for(target["dir"]), "stock view")):
        if candidate and os.path.isfile(candidate):
            try:
                import shutil
                backup_current(view, label="pre-rollback")
                shutil.copy2(candidate, view)
                return True, "restored the %s (%s)" % (name, reason)
            except Exception as e:
                return False, "rollback failed: %s" % e
    return False, "no last-good or stock view to restore (%s)" % reason


def restore_stock_view(target):
    """Remove the customization from exactly one provider."""
    view = os.path.join(target["dir"], "LockView.qml")
    stock = stock_backup_for(target["dir"])
    if not stock or not os.path.isfile(stock):
        return False, "no stock view saved for this plugin yet"
    import shutil
    backup_current(view, label="pre-stock")
    shutil.copy2(stock, view)
    return True, "stock view restored"


def apply_view(settings, target=None, restart=True, verify=True):
    """Render, validate, install, reload, verify; roll back if it did not load.

    This is the only path that writes LockView.qml, so a broken render can never
    reach the shell: validation happens before the write, and a view that still
    fails after the restart is replaced by the last one that worked.
    """
    conflicts = []
    if target is None:
        target, conflicts, _available = resolve_lock_target()
    if not target:
        status = lock_target_status()
        return {"ok": False, "lock": status,
                "error": status["warnings"][0] if status["warnings"] else "no enabled lock plugin"}

    service = os.path.join(target["dir"], "Service.qml")
    text, add_props, add_signals, add_functions = render_for_target(settings, target["dir"])
    problems = validate_view(text, service)
    if problems:
        return {"ok": False, "id": target["id"], "dir": target["dir"],
                "error": "refusing to install: " + "; ".join(problems),
                "problems": problems}

    view = os.path.join(target["dir"], "LockView.qml")
    try:
        with open(view) as f:
            current = f.read()
    except Exception:
        current = ""
    changed = current != text
    if changed:
        install_view(target, text)

    result = {"ok": True, "id": target["id"], "dir": target["dir"],
              "changed": changed, "verified": None,
              "added_properties": add_props, "added_signals": add_signals,
              "added_functions": add_functions,
              "conflicts": [t["id"] for t in conflicts]}
    if not changed:
        # Anything already on disk and running is a known-good fallback.
        if not os.path.isfile(last_good_path(target["dir"])):
            try:
                with open(last_good_path(target["dir"]), "w") as f:
                    f.write(current or text)
            except Exception:
                pass
        return result
    if not restart:
        return result

    started = time.time()
    ok, err = restart_shell()
    result["restarted"] = ok
    if not ok:
        # A locked session is the one expected refusal: the file is installed
        # and takes effect at the next shell start, never by dropping the lock
        # client. Any other failure means nothing will pick the change up.
        result["restart_error"] = err
        result["verified"] = False
        if "Refusing to restart" not in (err or ""):
            result["ok"] = False
            result["error"] = "shell restart failed: " + (err or "unknown")
        return result

    wait_shell_ready()
    if not verify:
        return result
    load_errors = shell_errors_since(started, target)
    if not load_errors and not wait_shell_ready(timeout=5):
        load_errors = ["the shell did not answer after the restart"]
    if not load_errors:
        result["verified"] = True
        try:
            with open(last_good_path(target["dir"]), "w") as f:
                f.write(text)
        except Exception:
            pass
        return result

    rolled, detail = rollback_view(target, "new view failed to load")
    result.update({"ok": False, "verified": False, "load_errors": load_errors[:5],
                   "rollback": detail,
                   "error": "view failed to load after restart: " + load_errors[0][:200]})
    if rolled:
        restart_shell()
        wait_shell_ready()
    return result

# ---------------------------------------------------------------------------
# Authentication backends (fingerprint / face)
# ---------------------------------------------------------------------------
# Neither flow is invented here: Omarchy ships the fingerprint PAM setup and
# omaFace ships the face engine. The studio only reports what the machine can
# actually do and drives those tools, so a laptop with no reader says so
# instead of offering a switch that cannot work.

OMAFACE_BIN = "/usr/bin/omaface"
OMAFACE_LOCK_PAM = "/etc/pam.d/omaface-lock"
FINGERPRINT_LOCK_PAM = "/etc/pam.d/omarchy-lock-fingerprint"


def run_cmd(cmd, timeout=8):
    """Run a command, never raise: (returncode, combined output)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except FileNotFoundError:
        return 127, "not installed: " + cmd[0]
    except Exception as e:
        return 1, str(e)


def video_camera_names():
    """Names of the v4l2 capture devices, straight from sysfs."""
    names = []
    base = "/sys/class/video4linux"
    try:
        for d in sorted(os.listdir(base)):
            try:
                with open(os.path.join(base, d, "name")) as f:
                    names.append(f.read().strip())
            except OSError:
                pass
    except OSError:
        pass
    return names


def ir_camera_name():
    for n in video_camera_names():
        low = n.lower()
        if "ir camera" in low or "infrared" in low:
            return n
    return ""


def face_status():
    camera = ir_camera_name()
    installed = os.path.isfile(OMAFACE_BIN)
    pam = os.path.isfile(OMAFACE_LOCK_PAM)
    appearances = 0
    lock_on = False
    detail = ""
    if installed:
        rc, out = run_cmd([OMAFACE_BIN, "status"], timeout=6)
        if rc == 0:
            for line in out.splitlines():
                s = line.strip()
                m = re.match(r"^appearances\s+(\d+)", s)
                if m:
                    appearances = int(m.group(1))
                elif re.match(r"^lock\s+(on|off)$", s):
                    lock_on = s.endswith("on")
        else:
            detail = out.splitlines()[0] if out else ""
    enrolled = appearances > 0
    if not camera:
        reason = "No IR camera on this machine."
    elif not installed:
        reason = "omaFace is not installed."
    elif not pam:
        reason = "Lock-screen PAM service missing — run omaface setup."
    elif not enrolled:
        reason = "No face enrolled yet."
    elif not lock_on:
        reason = "Face unlock is turned off for the lock screen."
    else:
        reason = "Ready — looks for your face when the lock screen wakes."
    return {
        "component": "face",
        "camera": camera,
        "hardware": bool(camera),
        "installed": installed,
        "pam": pam,
        "appearances": appearances,
        "enrolled": enrolled,
        "lock_enabled": lock_on,
        "available": bool(camera) and installed and pam and enrolled and lock_on,
        "reason": reason,
        "detail": detail,
    }


def fingerprint_status():
    reader = run_cmd(["omarchy-hw-fingerprint"], timeout=5)[0] == 0
    installed = any(os.path.exists(p) for p in (
        "/usr/bin/fprintd-enroll", "/usr/bin/fprintd-list"))
    pam = os.path.isfile(FINGERPRINT_LOCK_PAM)
    prints = 0
    if installed:
        rc, out = run_cmd(["fprintd-list", os.environ.get("USER", "")], timeout=8)
        if rc == 0 and "no prints" not in out.lower():
            prints = len([l for l in out.splitlines() if l.strip().startswith("-")])
    enrolled = prints > 0
    if not reader:
        reason = "No fingerprint reader detected on this machine."
    elif not installed:
        reason = "Reader found — fprintd is not installed yet."
    elif not enrolled:
        reason = "Reader found — no fingerprint enrolled yet."
    elif not pam:
        reason = "Fingerprints enrolled, but the lock screen PAM service is missing."
    else:
        reason = "Ready — the lock screen waits on the reader."
    return {
        "component": "fingerprint",
        "hardware": reader,
        "installed": installed,
        "pam": pam,
        "prints": prints,
        "enrolled": enrolled,
        "available": reader and installed and pam and enrolled,
        "reason": reason,
    }


THEME_TOML = os.path.expanduser("~/.local/state/omarchy/current/theme/shell.toml")
USER_TOML = os.path.expanduser("~/.config/omarchy/shell.toml")


def _shell_toml(*paths):
    """Flat {"section.key": value} from the shell's TOML, user file last."""
    vals = {}
    for path in paths:
        try:
            section = ""
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    m = re.match(r"^\[([A-Za-z0-9_-]+)\]", line)
                    if m:
                        section = m.group(1)
                        continue
                    m = re.match(r'^([A-Za-z0-9_-]+)\s*=\s*["\']?([^"\'#]+)["\']?\s*(?:#.*)?$', line)
                    if m and section:
                        vals[section + "." + m.group(1)] = m.group(2).strip()
        except Exception:
            continue
    return vals


def shell_heading_px():
    """Style.font.heading in pixels — the size the lock's text derives from.

    Read from Omarchy's own shell.toml (theme base, then the user override) so
    the preview draws the clock at the size the lock screen really uses.
    """
    vals = _shell_toml(THEME_TOML, USER_TOML)
    try:
        base = max(1, int(float(vals.get("font.base-size", 12))))
    except Exception:
        base = 12
    try:
        return max(1, int(float(vals["font.heading"])))
    except Exception:
        return max(1, round(base * 1.333))


def screen_size():
    """Logical size of the focused monitor (Hyprland reports pixels + scale)."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        mons = [m for m in json.loads(out) if not m.get("disabled")]
        m = next((m for m in mons if m.get("focused")), mons[0] if mons else None)
        if m:
            sc = float(m.get("scale") or 1) or 1
            w, h = int(round(m["width"] / sc)), int(round(m["height"] / sc))
            if w > 0 and h > 0:
                return {"width": w, "height": h}
    except Exception:
        pass
    return {"width": 1920, "height": 1080}


def preview_info():
    """Everything the preview needs to look like the real lock screen."""
    size = screen_size()
    return {"width": size["width"], "height": size["height"],
            "heading": shell_heading_px()}


def auth_status():
    return {"face": face_status(), "fingerprint": fingerprint_status(),
            "lock": lock_target_status()}


def launch_terminal(command):
    """Open an interactive command in a terminal window and return at once."""
    try:
        subprocess.Popen(
            ["omarchy-launch-terminal", "bash", "-lc",
             command + "; echo; read -r -p 'Press Enter to close…'"],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, ""
    except Exception as e:
        return False, str(e)


def auth_action(component, action):
    if component == "face":
        if not os.path.isfile(OMAFACE_BIN):
            return {"ok": False, "error": "omaFace is not installed"}
        if action == "enroll":
            ok, err = launch_terminal("omaface enroll")
            return {"ok": ok, "error": err,
                    "message": "Look at the camera and turn your head slowly."}
        if action == "test":
            ok, err = launch_terminal("omaface test")
            return {"ok": ok, "error": err, "message": "Testing recognition…"}
        if action in ("enable", "disable"):
            rc, out = run_cmd([OMAFACE_BIN, action, "lock"], timeout=15)
            return {"ok": rc == 0, "error": "" if rc == 0 else out,
                    "message": "Face unlock %s for the lock screen." % (
                        "on" if action == "enable" else "off")}
        if action == "setup":
            ok, err = launch_terminal("omaface setup")
            return {"ok": ok, "error": err, "message": "omaFace setup window opened."}
        return {"ok": False, "error": "unknown face action"}

    if component == "fingerprint":
        if not fingerprint_status()["hardware"]:
            return {"ok": False,
                    "error": "No fingerprint reader detected — nothing to set up."}
        if action == "setup":
            ok, err = launch_terminal("omarchy-setup-security-fingerprint")
            return {"ok": ok, "error": err,
                    "message": "Enrol a finger when asked, then test with sudo."}
        if action == "enroll":
            ok, err = launch_terminal('fprintd-enroll "$USER"')
            return {"ok": ok, "error": err, "message": "Touch the reader."}
        return {"ok": False, "error": "unknown fingerprint action"}

    return {"ok": False, "error": "unknown component"}

