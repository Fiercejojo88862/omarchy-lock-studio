def with_alpha(hexcolor, a):
    h = hexcolor.lstrip("#")
    if len(h) == 3:
        h = h[0]*2 + h[1]*2 + h[2]*2
    r, g, b = h[0:2], h[2:4], h[4:6]
    aa = "%02x" % max(0, min(255, int(round(a * 255))))
    return "#" + r + g + b + aa


def effective_bg(s):
    bg = s.get("bg_image", "")
    if bg:
        return bg.replace("file://", "")
    return active_theme_colors().get("background", "#000000")


def readable_text_color(bg):
    r = g = b = 0
    n = 1
    if bg and (bg.startswith("/") or "://" in bg):
        try:
            from PIL import Image
            with Image.open(os.path.expanduser(bg.replace("file://", ""))) as im:
                im = im.convert("RGB").resize((24, 24))
                px = list(im.getdata())
                r = sum(p[0] for p in px); g = sum(p[1] for p in px); b = sum(p[2] for p in px)
                n = len(px)
        except Exception:
            r = g = b = 128; n = 1
    elif bg and bg.startswith("#"):
        h = bg.lstrip("#")
        if len(h) == 3:
            h = h[0]*2 + h[1]*2 + h[2]*2
        r = int(h[0:2], 16); g = int(h[2:4], 16); b = int(h[4:6], 16); n = 1
    lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / (n * 255.0)
    return "#000000" if lum > 0.5 else "#ffffff"


def effective_clock_format(fmt, show_seconds):
    fmt = (fmt or "hh:mm AP").strip() or "hh:mm AP"
    if not show_seconds:
        return fmt
    if "ss" in fmt:
        return fmt
    if "mm" in fmt:
        return fmt.replace("mm", "mm:ss", 1)
    return fmt + ":ss"


def render_lockview(s):
    def qstr(v):
        return json.dumps(v)
    def qbool(v):
        return "true" if v else "false"
    def qnum(v):
        return str(v)
    bg = s.get("bg_image", "")
    if bg:
        bg = os.path.expanduser(bg)
    avatar = s.get("profile_avatar", "")
    if avatar:
        avatar = os.path.expanduser(avatar)
    # The verse is centred and the profile sits in a bottom corner, so a wide
    # verse runs straight through the name. When both share the bottom band,
    # narrow the verse and nudge it away from the profile.
    quote_width = "Math.min(parent.width * 0.7, 900)"
    quote_offset = "0"
    prof_pos = s.get("profile_pos", "bottom-left")
    verses_pos = s.get("verses_pos", "bottom-center")
    if (s.get("profile_enabled") and s.get("verses_enabled")
            and prof_pos.split("-")[0] == verses_pos.split("-")[0]):
        quote_width = "Math.min(parent.width * 0.55, 820)"
        if "left" in prof_pos and "center" in verses_pos:
            quote_offset = "Math.round(parent.width * 0.07)"
        elif "right" in prof_pos and "center" in verses_pos:
            quote_offset = "-Math.round(parent.width * 0.07)"
    mode = s.get("text_color_mode", "theme")
    if mode == "theme":
        lock_text = "Color.lock.text"
        lock_ph = "Color.lock.placeholder"
    else:
