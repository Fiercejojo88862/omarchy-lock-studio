# ---------------------------------------------------------------------------
# Host contract (columns the running Service.qml hands to LockView)
# ---------------------------------------------------------------------------
# An update to Omarchy or omaFace can add a property to the LockView instance
# inside Service.qml (4.5 added videoPosterPath and fingerprintUnavailable).
# Assigning a property the view does not declare is a QML runtime error, and the
# lock then has no view at all. So the host's own Service.qml is read and any
# property it assigns that the template lacks is declared as `property var`
# (and any on<Signal> handler as a no-argument signal) — the view keeps loading
# and ignores what the studio does not render yet.

def _balanced_block(text, start):
    """Text between the brace at `start` and its match, nested braces included."""
    depth = 1
    i = start
    while i < len(text) and depth:
        ch = text[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
        i += 1
    return text[start:i - 1]


def service_contract(service_path):
    """What the host Service.qml requires of a LockView.

    Returns (properties, signals, function_calls).
    """
    props, signals, calls = set(), set(), set()
    try:
        with open(service_path) as f:
            text = f.read()
    except Exception:
        return props, signals, calls
    for m in re.finditer(r"\bLockView\s*\{", text):
        block = _balanced_block(text, m.end())
        lines = [ln for ln in block.splitlines() if ln.strip() and not ln.strip().startswith("//")]
        if not lines:
            continue
        base = min(len(ln) - len(ln.lstrip()) for ln in lines)
        for ln in lines:
            if len(ln) - len(ln.lstrip()) != base:
                continue
            hit = re.match(r"\s*([A-Za-z_]\w*)\s*:", ln)
            if not hit:
                continue
            name = hit.group(1)
            if len(name) > 2 and name.startswith("on") and name[2].isupper():
                signals.add(name[2].lower() + name[3:])
            elif name != "id":
                props.add(name)
    # Service.qml may also call methods on the view (lockView.clearPassword()).
    # A missing function is only an error when it is called, so stub anything
    # the view does not define instead of discovering it at lock time.
    for m in re.finditer(r"\blockView\.([A-Za-z_]\w*)\s*\(", text):
        calls.add(m.group(1))
    return props, signals, calls


def declared_in_view(qml_text):
    props = set(re.findall(r"^[ \t]*(?:readonly\s+)?property\s+[\w.<>]+\s+(\w+)", qml_text, re.M))
    signals = set(re.findall(r"^[ \t]*signal\s+(\w+)", qml_text, re.M))
    functions = set(re.findall(r"^[ \t]*function\s+(\w+)\s*\(", qml_text, re.M))
    return props, signals, functions


def apply_contract(qml_text, service_path):
    """Declare anything the host requires that the view is missing.

    Returns (text, added_properties, added_signals, added_functions).
    """
    want_props, want_signals, want_calls = service_contract(service_path)
    have_props, have_signals, have_functions = declared_in_view(qml_text)
    add_props = sorted(want_props - have_props)
    add_signals = sorted(want_signals - have_signals)
    add_functions = sorted(want_calls - have_functions)
    if not add_props and not add_signals and not add_functions:
        return qml_text, [], [], []
    shim = ["  // --- host contract, refreshed by omarchy-lock-studio after updates ---"]
    for name in add_props:
        shim.append('  property var %s: ""' % name)
    for name in add_signals:
        shim.append("  signal %s()" % name)
    for name in add_functions:
        shim.append("  function %s() {}" % name)
    anchor = "  // --- omarchy-lock-studio settings (generated, do not edit by hand) ---"
    block = "\n".join(shim) + "\n\n"
    if anchor in qml_text:
        qml_text = qml_text.replace(anchor, block + anchor, 1)
    else:
        qml_text = qml_text.replace("  id: root\n", "  id: root\n\n" + block, 1)
    return qml_text, add_props, add_signals, add_functions


def render_for_target(settings, target_dir):
    """Render the saved settings for one provider, with the host contract met."""
    text = render_lockview(settings)
    text = ("// " + GENERATED_MARKER + " — safe to delete; re-apply from the app.\n"
            + text)
    if not target_dir:
        return text, [], [], []
    return apply_contract(text, os.path.join(target_dir, "Service.qml"))


# ---------------------------------------------------------------------------
# Validation and rollback
# ---------------------------------------------------------------------------
# The lock service builds its WlSessionLockSurface (and therefore this view) at
# load time, so a bad view is silent until the shell restarts — and then the
# lock has no field to type into. Nothing unverified may reach the file the
# shell loads, and a change that fails after restart must put the last working
# view back on its own.

def unbalanced(text):
    """True when braces/brackets/parens do not balance outside strings."""
    pairs = {")": "(", "]": "[", "}": "{"}
    stack = []
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch == "/" and i + 1 < n and text[i + 1] == "/":
            i = text.find("\n", i)
            if i < 0:
                break
        elif ch == "/" and i + 1 < n and text[i + 1] == "*":
            end = text.find("*/", i + 2)
            if end < 0:
                return True
            i = end + 2
            continue
        elif ch in "\"'`":
            quote = ch
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == quote:
                    break
                i += 1
        elif ch in "([{":
            stack.append(ch)
        elif ch in ")]}":
            if not stack or stack.pop() != pairs[ch]:
                return True
        i += 1
    return bool(stack)


def validate_view(text, service_path):
    """Problems that must stop an install, as a list of strings."""
    problems = []
    leftovers = sorted(set(re.findall(r"__[A-Z][A-Z0-9_]*__", text)))
    if leftovers:
        problems.append("unfilled template tokens: " + ", ".join(leftovers))
    if "id: root" not in text:
        problems.append("root item is missing")
    if unbalanced(text):
        problems.append("unbalanced braces, brackets or parentheses")
    for need in ("import QtQuick", "import qs.Commons"):
        if need not in text:
            problems.append("missing " + need)
    if service_path:
        want_props, want_signals, want_calls = service_contract(service_path)
        have_props, have_signals, have_functions = declared_in_view(text)
        missing = sorted((want_props - have_props) | (want_signals - have_signals)
                         | (want_calls - have_functions))
        if missing:
            problems.append("host contract unmet: " + ", ".join(missing))
    # A syntax pass with Qt's own parser when it is installed.
    lint = "/usr/bin/qmllint"
    if os.path.isfile(lint):
        tmp = None
        try:
            fd, tmp = tempfile.mkstemp(suffix=".qml", prefix="lock-studio-check-")
            with os.fdopen(fd, "w") as f:
                f.write(text)
            p = subprocess.run([lint, tmp], capture_output=True, text=True, timeout=20)
            if p.returncode != 0 and (p.stdout + p.stderr).strip():
                problems.append("qmllint: " + (p.stdout + p.stderr).strip()[:400])
        except Exception:
            pass
        finally:
            if tmp:
                try:
                    os.unlink(tmp)
                except Exception:
                    pass
    return problems


SHELL_ERROR_PATTERNS = (
    "Cannot assign to non-existent property",
    "Unable to assign",
    "is not a type",
    "LockView",
)


def shell_errors_since(epoch, target=None):
    """Shell log lines since `epoch` that mean the lock view did not load.

    Only lines about this plugin, or about LockView itself, count: another
    plugin's stale import must not trigger a rollback of a good lock view.
    """
    try:
        p = subprocess.run(["journalctl", "--user", "-t", "omarchy-shell",
                            "--since", "@%.3f" % float(epoch), "--no-pager"],
                           capture_output=True, text=True, timeout=20)
    except Exception:
        return []
    marker = os.path.basename((target or {}).get("dir", "").rstrip("/"))
    out = []
    for line in (p.stdout or "").splitlines():
        if "rror" not in line and "WARN" not in line:
            continue
        about_us = "LockView" in line or (marker and marker in line)
        if about_us and any(pat in line for pat in SHELL_ERROR_PATTERNS):
            out.append(line.strip())
    return out


def wait_shell_ready(timeout=30):
    end = time.time() + timeout
    while time.time() < end:
        try:
            p = subprocess.run(["omarchy-shell", "shell", "ping"],
                               capture_output=True, text=True, timeout=5)
            if p.returncode == 0:
                return True
        except Exception:
            pass
        time.sleep(0.5)
    return False


