    </div>

    <div class="auth-card">
      <div class="auth-head"><span class="auth-title">Touch ID / Fingerprint</span><span class="badge" id="fp-badge">checking…</span></div>
      <div class="hint" id="fp-desc">—</div>
      <div class="btns">
        <button class="ghost" id="fp-setup" type="button">Install &amp; configure</button>
        <button class="ghost" id="fp-enroll" type="button">Enroll fingerprint</button>
