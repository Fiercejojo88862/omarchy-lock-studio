# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _send_local_file(self, path):
        """Serve a picture for the preview (images only, capped size)."""
        import mimetypes
        path = urllib.parse.unquote(path or "")
        if path.startswith("file://"):
            path = path[7:]
        path = os.path.expanduser(path)
        ctype = mimetypes.guess_type(path)[0] or ""
        if not path or not os.path.isfile(path) or not ctype.startswith("image/"):
            self._send(404, {"error": "not an image"})
            return
        try:
            if os.path.getsize(path) > 128 * 1024 * 1024:
                self._send(413, {"error": "file too large"})
                return
            with open(path, "rb") as f:
                data = f.read()
        except Exception:
            self._send(500, {"error": "unreadable"})
            return
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        p = urllib.parse.urlparse(self.path).path
        if p == "/" or p == "/index.html":
            self._send(200, HTML.replace("__VERSES_JSON__", json.dumps(VERSES, ensure_ascii=False)).replace(
                "__FONT_OPTIONS__",
                "".join('<option value="%s">' % f.replace('"', "") for f in installed_fonts())), "text/html")
        elif p == "/api/theme":
            self._send(200, active_theme_colors())
        elif p == "/api/preview":
            self._send(200, preview_info())
        elif p == "/api/settings":
            self._send(200, load_settings())
        elif p == "/api/media":
            self._send(200, playerctl_snapshot())
        elif p == "/api/backups":
            self._send(200, list_backups())
        elif p == "/api/repo-status":
            self._send(200, repo_status())
        elif p == "/api/auth":
            self._send(200, auth_status())
        elif p == "/api/files":
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            self._send(200, list_files(q.get("path", [""])[0]))
        elif p == "/api/file":
            # The preview shows your picture. A page served from 127.0.0.1 is
            # not allowed to read file:// URLs, so the bytes come through here.
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            self._send_local_file(q.get("path", [""])[0])
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        p = urllib.parse.urlparse(self.path).path
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length) if length else b""
        try:
            data = json.loads(raw) if raw else {}
        except Exception:
            data = {}
        plugin = find_plugin_dir()
        lockview = os.path.join(plugin, "LockView.qml") if plugin else None

        if p == "/api/settings":
            save_settings(data)
            self._send(200, {"ok": True})
        elif p == "/api/sync-repo":
            self._send(200, sync_repo())
        elif p == "/api/apply":
            save_settings(data)
            result = apply_view(data)
            self._send(200 if result.get("ok") else 500, result)
        elif p == "/api/restore":
            if not lockview:
                self._send(500, {"ok": False, "error": "no enabled lock plugin"})
                return
            ok, err = restore_backup(data.get("file", ""), lockview)
            self._send(200, {"ok": ok, "error": err})
        elif p == "/api/restore-stock":
            target, _conflicts, _available = resolve_lock_target()
            if not target:
                self._send(500, {"ok": False, "error": "no enabled lock plugin"})
                return
            ok, msg = restore_stock_view(target)
            if not ok:
                self._send(500, {"ok": False, "error": msg})
                return
            started = time.time()
            rok, rerr = restart_shell()
            if rok:
                wait_shell_ready()
                errs = shell_errors_since(started, target)
                if errs:
                    self._send(200, {"ok": False, "error": errs[0][:200]})
                    return
            self._send(200, {"ok": rok, "error": "" if rok else rerr, "detail": msg})
        elif p == "/api/process-image":
            kind = data.get("kind", "background")
            if kind not in ("background", "avatar"):
                kind = "background"
            self._send(200, process_image(data.get("path", ""), kind))
        elif p == "/api/auto-color":
            self._send(200, {"color": readable_text_color(effective_bg(data if data else load_settings()))})
        elif p == "/api/auth/action":
            self._send(200, auth_action(data.get("component", ""), data.get("action", "")))
        else:
            self._send(404, {"error": "not found"})

    def log_message(self, *a):
        pass

def sync_now(restart=False, quiet=False):
    """Re-apply the saved settings to the active lock provider.

    Called at startup and from the post-update hook, so an Omarchy or omaFace
    update that rebuilds the plugin hands the customized view back instead of
    leaving the stock one in place (or a view the new Service.qml cannot load).
    Validation, restart verification and rollback all live in apply_view().
    """
    settings = load_settings()
    result = apply_view(settings, restart=restart, verify=restart)
    if not quiet:
        if not result.get("ok"):
            print("Not applied: " + (result.get("error") or "unknown"))
        else:
            print(("Updated %s (%s)" % (result["id"], result["dir"]))
                  if result.get("changed") else ("%s already current" % result["id"]))
            carried = (result.get("added_properties", []) + result.get("added_signals", [])
                       + result.get("added_functions", []))
            if carried:
                print("Carried new host contract: " + ", ".join(carried))
            if result.get("verified") is True:
                print("Verified after restart.")
            elif result.get("verified") is False and result.get("load_errors"):
                print("Rolled back: " + (result.get("rollback") or ""))
            if result.get("restart_error"):
                print("Shell restart: " + result["restart_error"])
    return result


def studio_running(url, timeout=0.7):
    """True when another lock-studio server already answers on this port."""
    try:
        with urllib.request.urlopen(url + "api/settings", timeout=timeout) as r:
            return r.status == 200 and b"verses_enabled" in r.read()
    except Exception:
        return False


def run_app_window(url):
    """Show the studio in its own window; False when GTK/WebKit are unusable.

    A real window (not a browser tab) means it lives in the launcher and the
    dock with its own icon, and closing it stops the server behind it.
    """
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("WebKit2", "4.1")
        from gi.repository import Gdk, GLib, Gtk, WebKit2
    except Exception as exc:
        print("No app window (%s) — falling back to the browser." % exc)
        return False
    if Gdk.Display.get_default() is None:
        print("No display — starting the server only.")
        return False

    # Names the window after the .desktop file so the shell can match the icon
    # and any window rule to it.
    GLib.set_prgname("omarchy-lock-studio")
    GLib.set_application_name("Omarchy Lock Studio")

    win = Gtk.Window(title="Omarchy Lock Studio")
    win.set_default_size(1340, 940)
    # The UI is a settings column beside a live preview; below this it folds
    # into a stamp. The hint also stops a tiled window opening too narrow.
    geo = Gdk.Geometry()
    geo.min_width, geo.min_height = 900, 620
    win.set_geometry_hints(None, geo, Gdk.WindowHints.MIN_SIZE)
    win.set_size_request(900, 620)
    win.set_icon_name("omarchy-lock-studio")
    view = WebKit2.WebView()
    view.load_uri(url)
    win.add(view)

    def on_key(_w, ev):
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        if ev.keyval == Gdk.KEY_F5 or (ctrl and ev.keyval in (Gdk.KEY_r, Gdk.KEY_R)):
            view.reload()
            return True
        if ctrl and ev.keyval in (Gdk.KEY_q, Gdk.KEY_w):
            win.destroy()
            return True
        return False

    win.connect("key-press-event", on_key)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return True


def show_studio(url, mode):
    """Open the UI the requested way: own window, else a browser tab."""
    if mode in ("app", "auto") and run_app_window(url):
        return "app"
    for opener in (["firefox", url], ["xdg-open", url]):
        try:
            subprocess.Popen(opener)
            return "browser"
        except Exception:
            continue
    print("Could not open a window; open " + url + " manually.")
    return None


def main():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    plugin = find_plugin_dir()
    lockview = os.path.join(plugin, "LockView.qml") if plugin else None
    if plugin:
        ensure_initial_backup(lockview, label=os.path.basename(plugin))
    ensure_face_glyph(plugin)

    args = sys.argv[1:]
    if "--restore-stock" in args:
        target, _conflicts, _available = resolve_lock_target()
        if not target:
            print("Cannot restore stock: no enabled lock plugin.")
            return
        ok, msg = restore_stock_view(target)
        if ok:
            rok, err = restart_shell()
            print("Restored stock." if rok else ("Restored, but the shell restart failed: " + err))
        else:
            print("Cannot restore stock: " + msg)
        return

    if "--sync" in args:
        r = sync_now(restart="--restart" in args, quiet="--quiet" in args)
        sys.exit(0 if r.get("ok") else 2)

    if "--sync-repo" in args:
        r = sync_repo()
        if r.get("ok"):
            print(("Synced: " + r["commit"]) if r.get("committed") else "Project repo already up to date.")
        else:
            print("Sync failed: " + r.get("error", "unknown"))
        return

    # A relaunch after an update repairs the view before the browser opens, so
    # the preview never lies about what the lock will show.
    if plugin:
        sync_now(quiet=True)

    no_open = "--no-open" in sys.argv
    mode = "browser" if "--browser" in sys.argv else ("app" if "--app" in sys.argv else "auto")
    url = f"http://127.0.0.1:{PORT}/"

    # Already running (a second click on the launcher): open a window onto the
    # live server instead of killing it out from under the first one.
    if not no_open and studio_running(url):
        print("Omarchy Lock Studio is already running.")
        show_studio(url, mode)
        return

    server = None
    for attempt in range(6):
        try:
            server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
            break
        except OSError:
            if attempt == 0:
                print(f"Port {PORT} in use — taking over the existing instance…")
            free_port(PORT)
            time.sleep(0.5)
    if server is None:
        print(f"Could not bind {PORT}. Opening the running instance's UI.")
        if not no_open:
            show_studio(url, mode)
        return
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    print(f"Omarchy Lock Studio running at {url}")
    if not no_open:
        if show_studio(url, mode) == "app":
            # The window is the app: closing it stops the server with it.
            sys.stdout.flush()
            os._exit(0)
        print("Press Ctrl+C to stop.")
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        print("\nStopping.")
        server.shutdown()

if __name__ == "__main__":
    main()
