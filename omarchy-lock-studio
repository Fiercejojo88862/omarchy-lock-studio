<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Omarchy Lock Studio</title>
<style>
  :root {
    --bg: #101019; --fg: #cdd6f4; --accent: #89b4fa; --muted: #6c7086;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: "JetBrains Mono Nerd Font", ui-monospace, monospace;
    background: #0a0a0f; color: var(--fg); display: flex; height: 100vh;
  }
  #panel {
    width: 380px; min-width: 380px; overflow-y: auto; padding: 18px;
    background: #14141c; border-right: 1px solid #26263a;
  }
  #stage { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
  h1 { font-size: 16px; margin: 0 0 4px; color: var(--accent); }
  .sub { font-size: 11px; color: var(--muted); margin-bottom: 16px; }
  .group { border: 1px solid #26263a; border-radius: 10px; padding: 12px; margin-bottom: 12px; }
  .group > h2 { font-size: 12px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); }
  label { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12px; margin: 7px 0; }
  label span { color: var(--fg); }
  input[type=text], select {
    background: #0d0d14; color: var(--fg); border: 1px solid #2e2e44;
    border-radius: 6px; padding: 5px 7px; font-family: inherit; font-size: 12px; width: 180px;
  }
  input[type=range] { width: 150px; }
  input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); }
  .btns { display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; }
  button {
    background: var(--accent); color: #0a0a0f; border: 0; border-radius: 8px;
    padding: 8px 12px; font-family: inherit; font-weight: bold; font-size: 12px; cursor: pointer;
  }
  button.ghost { background: transparent; color: var(--fg); border: 1px solid #2e2e44; }
  button.danger { background: #f38ba8; }
  /* Lock preview */
  #screen {
    position: relative; width: 100%; max-width: 900px; aspect-ratio: 16/9;
    border-radius: 16px; overflow: hidden; background: var(--bg);
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
  }
  #screen .bg { position: absolute; inset: 0; background-size: cover; background-position: center; filter: blur(8px); transform: scale(1.1); }
  #screen .dim { position: absolute; inset: 0; background: #000; opacity: 0.25; }
  .pw {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: 300px; height: 52px; border-radius: 12px; background: rgba(255,255,255,.06);
    border: 2px solid var(--accent); display: flex; align-items: center; justify-content: center;
    color: var(--muted); font-size: 14px; letter-spacing: 2px;
  }
  .w-clock { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; color: var(--fg); }
  .w-clock .t { font-weight: bold; }
  .w-clock .d { color: var(--muted); }
  .w-profile { position: absolute; display: flex; gap: 12px; align-items: center; color: var(--fg); }
  .w-profile .av { width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.08); display:flex; align-items:center; justify-content:center; font-weight:bold; overflow:hidden; }
  .w-profile .av img { width:100%; height:100%; object-fit: cover; }
  .w-profile .nm { font-weight: bold; }
  .w-profile .ho { color: var(--muted); font-size: 12px; }
  .w-quote { position: absolute; left: 50%; transform: translateX(-50%); width: 70%; text-align: center; color: var(--fg); font-style: italic; }
  .w-quote .a { color: var(--muted); font-style: normal; font-size: 12px; margin-top: 4px; }
  .w-media { position: absolute; display: flex; gap: 10px; align-items: center; color: var(--fg); }
  .w-media .art { width: 44px; height: 44px; border-radius: 8px; background: rgba(255,255,255,.08); background-size: cover; }
  .w-media .ti { font-weight: bold; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .w-media .ar { color: var(--muted); font-size: 12px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .toast { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); background: #1e1e2e; border:1px solid var(--accent); color: var(--fg); padding: 8px 14px; border-radius: 8px; font-size: 12px; opacity: 0; transition: opacity .3s; }
  .toast.show { opacity: 1; }
  .hint { font-size: 10px; color: var(--muted); margin-top: 6px; line-height: 1.4; }
  .row { display: flex; align-items: center; gap: 8px; }
  .row label { flex: 1; }
  .modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 50; }
  .modal-box { width: 540px; max-height: 72vh; background: #14141c; border: 1px solid #2e2e44; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; }
  .modal-head { display: flex; align-items: center; gap: 8px; padding: 10px; border-bottom: 1px solid #2e2e44; font-size: 12px; }
  .modal-head #picker-path { flex: 1; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .modal-list { overflow-y: auto; padding: 6px; }
  .pick { padding: 8px 10px; border-radius: 6px; font-size: 13px; cursor: pointer; }
  .pick:hover { background: #1e1e2e; }
  .pick.dir { color: var(--accent); font-weight: bold; }
</style>
</head>
<body>
<div id="panel">
  <h1>Omarchy Lock Studio</h1>
  <div class="sub">Customize your Quickshell lock screen — safely.</div>

  <div class="group">
    <h2>Clock</h2>
    <label><span>Enabled</span><input type="checkbox" id="clock_enabled"></label>
    <label><span>Time format</span><input type="text" id="clock_format" value="hh:mm AP"></label>
    <label><span>Show seconds</span><input type="checkbox" id="clock_show_seconds"></label>
    <label><span>Show date</span><input type="checkbox" id="clock_show_date"></label>
    <label><span>Date format</span><input type="text" id="clock_date" value="dddd, MMMM d"></label>
    <label><span>Timezone</span><input type="text" id="clock_tz" placeholder="(system)"></label>
    <label><span>Size</span><input type="range" id="clock_scale" min="0.8" max="3" step="0.1"></label>
    <label><span>Position</span><select id="clock_vpos"><option value="top">Top</option><option value="bottom">Bottom</option></select></label>
  </div>

  <div class="group">
    <h2>Typography</h2>
    <label><span>Text font</span><input type="text" id="font_family" list="fontlist" placeholder="(theme font)"></label>
    <label><span>Clock font</span><input type="text" id="clock_font" list="fontlist" placeholder="(same as text)"></label>
    <label><span>Clock weight</span><select id="clock_weight">
      <option value="regular">Regular</option>
      <option value="medium">Medium</option>
      <option value="semibold">Semibold</option>
      <option value="bold">Bold</option>
      <option value="black">Black</option>
    </select></label>
    <label><span>Clock letter spacing</span><input type="range" id="clock_spacing" min="-2" max="12" step="0.5"></label>
    <div class="hint">Blank font = the Omarchy theme font. Clock font falls back to the text font, so one field styles everything. Names come from <code>fc-list</code>.</div>
  </div>
  <datalist id="fontlist">__FONT_OPTIONS__</datalist>

  <div class="group">
    <h2>User profile</h2>
    <label><span>Enabled</span><input type="checkbox" id="profile_enabled"></label>
    <label><span>Name</span><input type="text" id="profile_name"></label>
    <div class="row"><label><span>Avatar path</span><input type="text" id="profile_avatar" placeholder="~/.face"></label><button class="ghost" id="profile_avatar_browse" type="button">Browse…</button></div>
    <label><span>Show host</span><input type="checkbox" id="profile_show_host"></label>
    <label><span>Hostname</span><input type="text" id="profile_host"></label>
    <label><span>Welcome line</span><input type="checkbox" id="show_welcome"></label>
    <label><span>Welcome text</span><input type="text" id="welcome_text" placeholder="Welcome back, {name}"></label>
    <label><span>Position</span><select id="profile_pos">
      <option value="bottom-left">Bottom-left</option><option value="top-left">Top-left</option>
      <option value="bottom-right">Bottom-right</option><option value="top-right">Top-right</option>
    </select></label>
  </div>

  <div class="group">
    <h2>Text color</h2>
    <label><span>Mode</span><select id="text_color_mode">
      <option value="theme">Theme</option>
      <option value="custom">Custom</option>
      <option value="auto">Auto (from background)</option>
    </select></label>
    <label><span>Custom color</span><input type="text" id="text_color" placeholder="#ffffff"></label>
    <div class="hint">Auto picks black or white from your background brightness so text is never invisible (white-on-white).</div>
  </div>

  <div class="group">
    <h2>Dev quotes</h2>
    <label><span>Enabled</span><input type="checkbox" id="quotes_enabled"></label>
    <label><span>Larger text</span><input type="checkbox" id="quotes_big"></label>
    <label><span>Rotate every (s)</span><input type="text" id="quote_interval" value="12"></label>
    <label><span>Position</span><select id="quotes_pos">
      <option value="bottom-center">Bottom</option><option value="top-center">Top</option>
    </select></label>
  </div>

  <div class="group">
    <h2>MPRIS media</h2>
    <label><span>Enabled</span><input type="checkbox" id="media_enabled"></label>
    <label><span>Position</span><select id="media_pos">
      <option value="top-left">Top-left</option><option value="top-center">Top-center</option>
      <option value="bottom-left">Bottom-left</option><option value="bottom-center">Bottom-center</option>
    </select></label>
  </div>

  <div class="group">
    <h2>Background</h2>
    <div class="row"><label><span>Image path</span><input type="text" id="bg_image" placeholder="(theme default)"></label><button class="ghost" id="bg_browse" type="button">Browse…</button></div>
    <label><span>Blur</span><input type="range" id="bg_blur" min="0" max="2" step="0.1"></label>
    <label><span>Dim</span><input type="range" id="bg_dim" min="0" max="0.8" step="0.05"></label>
  </div>

  <div class="btns">
    <button id="apply">Apply &amp; restart</button>
    <button class="ghost" id="save">Save only</button>
  </div>
  <div class="btns" style="margin-top:8px">
    <button class="ghost" id="backup">Backup now</button>
    <button class="ghost" id="restore">Restore…</button>
    <button class="danger" id="stock">Restore stock</button>
  </div>
  <div class="btns" style="margin-top:8px">
    <button class="ghost" id="repo">Sync to project repo</button>
  </div>
  <div class="hint" id="repo-status">project repo: checking…</div>
  <div class="hint">Every Apply backs up the previous LockView.qml. If the lock ever misbehaves, hit Restore (or Restore stock) then re-lock. Settings + backups live in ~/.config/omarchy/lockscreen-customizer/.</div>
</div>

<div id="stage">
  <div id="screen">
    <div class="bg" id="pv-bg"></div>
    <div class="dim" id="pv-dim"></div>
    <div class="w-clock" id="pv-clock"><div class="t" id="pv-time"></div><div class="d" id="pv-date"></div></div>
    <div class="w-profile" id="pv-profile"><div class="av" id="pv-av"></div><div><div class="nm" id="pv-nm"></div><div class="ho" id="pv-ho"></div></div></div>
    <div class="w-quote" id="pv-quote"><div id="pv-qt"></div><div class="a" id="pv-qa"></div></div>
    <div class="w-media" id="pv-media"><div class="art" id="pv-art"></div><div><div class="ti" id="pv-ti"></div><div class="ar" id="pv-ar"></div></div></div>
    <div class="pw">Enter Password</div>
  </div>
</div>
<div class="modal" id="picker"><div class="modal-box">
  <div class="modal-head"><span id="picker-path"></span><button class="ghost" id="picker-up" type="button">Up</button><button class="ghost" id="picker-cancel" type="button">Cancel</button></div>
  <div class="modal-list" id="picker-list"></div>
</div></div>
<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);
let S = {};
let THEME = {};
const QUOTES = __QUOTES_JSON__;
let qIdx = 0;

const FIELDS = ["clock_enabled","clock_format","clock_show_seconds","clock_show_date","clock_date","clock_tz","clock_scale","clock_vpos","font_family","clock_font","clock_weight","clock_spacing",
  "profile_enabled","profile_name","profile_avatar","profile_show_host","profile_host","profile_pos",
  "quotes_enabled","quote_interval","quotes_pos","quotes_big","show_welcome","welcome_text","text_color_mode","text_color","media_enabled","media_pos","bg_image","bg_blur","bg_dim"];

function setVal(k,v){ if (typeof v === "boolean") $(k).checked = v; else if ($(k).type === "range" || $(k).type === "text" || $(k).tagName === "SELECT") $(k).value = v; }
function getVal(k){ const el = $(k); if (el.type === "checkbox") return el.checked; if (el.type === "range") return parseFloat(el.value); return el.value; }

function toast(msg){ const t=$("toast"); t.textContent=msg; t.classList.add("show"); setTimeout(()=>t.classList.remove("show"),2200); }

async function api(path, method="GET", body=null){
  const opt = { method, headers: { "Content-Type": "application/json" } };
  if (body) opt.body = JSON.stringify(body);
  const r = await fetch(path, opt);
  return await r.json().catch(()=>({ok:false}));
}

function applyTheme(){
  document.documentElement.style.setProperty("--bg", THEME.background||"#101019");
  document.documentElement.style.setProperty("--fg", THEME.foreground||"#cdd6f4");
  document.documentElement.style.setProperty("--accent", THEME.accent||"#89b4fa");
  document.documentElement.style.setProperty("--muted", THEME.muted||"#6c7086");
}

function pad(n){ return n<10?"0"+n:n; }
function fmtTime(d, f, tz, showSec){
  const sec = showSec || (f && f.indexOf("ss") >= 0);
  try { return new Intl.DateTimeFormat(undefined, { hour:"2-digit", minute:"2-digit", second: sec ? "2-digit" : undefined, hour12: /AP/.test(f)||/a/.test(f), timeZone: tz||undefined }).format(d); }
  catch(e){ return d.toTimeString().slice(0, sec ? 8 : 5); }
}
function fmtDate(d, f, tz){
  try { return new Intl.DateTimeFormat(undefined, { weekday:"short", month:"short", day:"numeric", timeZone: tz||undefined }).format(d); }
  catch(e){ return d.toDateString(); }
}

function renderPreview(){
  const bg = $("pv-bg");
  if (S.bg_image) { bg.style.backgroundImage = "url('file://"+S.bg_image+"')"; bg.style.filter = "blur("+(S.bg_blur*8)+"px)"; }
  else { bg.style.backgroundImage = "none"; bg.style.filter = "blur(8px)"; }
  $("pv-dim").style.opacity = (S.bg_dim===undefined?0.25:S.bg_dim);
  const clock = $("pv-clock");
  if (S.clock_enabled){ clock.style.display="block"; clock.style.top = S.clock_vpos==="top"?"48px":"auto"; clock.style.bottom = S.clock_vpos==="top"?"auto":"48px"; }
  else clock.style.display="none";
  $("pv-time").style.fontSize = (Style_h()*S.clock_scale)+"px";
  $("pv-date").style.display = S.clock_show_date?"block":"none";
  const baseFont = S.font_family || "";
  const clockFont = S.clock_font || baseFont;
  $("screen").style.fontFamily = baseFont;
  $("pv-time").style.fontFamily = clockFont;
  $("pv-date").style.fontFamily = clockFont;
  $("pv-time").style.fontWeight = ({regular:"400",medium:"500",semibold:"600",bold:"700",black:"900"})[S.clock_weight||"bold"] || "700";
  $("pv-time").style.letterSpacing = (S.clock_spacing||0)+"px";

  const prof = $("pv-profile");
  if (S.profile_enabled){ prof.style.display="flex"; placeCorner(prof, S.profile_pos); }
  else prof.style.display="none";
  $("pv-nm").textContent = (S.welcome_text || "Welcome back, {name}").replace("{name}", S.profile_name || "");
  $("pv-nm").style.display = (S.profile_enabled && S.show_welcome) ? "block" : "none";
  $("pv-ho").style.display = S.profile_show_host?"block":"none";
  $("pv-ho").textContent = S.profile_host||"";
  const av = $("pv-av");
  if (S.profile_avatar){ av.innerHTML = '<img src="file://'+S.profile_avatar+'">'; }
  else { av.textContent = (S.profile_name?S.profile_name[0].toUpperCase():"?"); }

  const q = $("pv-quote");
  if (S.quotes_enabled){ q.style.display="block"; q.style.top = S.quotes_pos==="top"?"48px":"auto"; q.style.bottom = S.quotes_pos==="top"?"auto":"48px"; }
  else q.style.display="none";
  $("pv-qt").style.fontSize = (S.quotes_big ? 30 : 20) + "px";
  $("pv-qa").style.fontSize = (S.quotes_big ? 16 : 13) + "px";
  applyLockText();
}

function withAlphaHex(hex, a){
  hex = hex.replace('#','');
  if (hex.length === 3) hex = hex.split('').map(c=>c+c).join('');
  const r=parseInt(hex.substr(0,2),16), g=parseInt(hex.substr(2,2),16), b=parseInt(hex.substr(4,2),16);
  return `rgba(${r},${g},${b},${a})`;
}
function setTextColors(fg, muted){
  document.documentElement.style.setProperty("--fg", fg);
  document.documentElement.style.setProperty("--muted", muted);
}
function applyLockText(){
  if (S.text_color_mode === "custom"){ const c = S.text_color || "#ffffff"; setTextColors(c, withAlphaHex(c, 0.6)); }
  else if (S.text_color_mode === "auto"){ api("/api/auto-color","POST",S).then(r=>{ if (r.color) setTextColors(r.color, withAlphaHex(r.color, 0.6)); }); }
  else { applyTheme(); }
}

function Style_h(){ return 26; } // base px for preview clock

function placeCorner(el, pos){
  const m="48px";
  el.style.top = pos.includes("top")?m:"auto";
  el.style.bottom = pos.includes("bottom")?m:"auto";
  el.style.left = pos.includes("left")?m:"auto";
  el.style.right = pos.includes("right")?m:"auto";
}

function tick(){
  const d = new Date();
  $("pv-time").textContent = fmtTime(d, S.clock_format, S.clock_tz, S.clock_show_seconds);
  $("pv-date").textContent = fmtDate(d, S.clock_date, S.clock_tz);
}
function tickQuote(){
  if (!QUOTES.length) return;
  const q = QUOTES[qIdx % QUOTES.length]; qIdx++;
  const sep = q.lastIndexOf(" — ");
  if (sep>=0){ $("pv-qt").textContent = q.slice(0,sep); $("pv-qa").textContent = q.slice(sep+3); }
  else { $("pv-qt").textContent = q; $("pv-qa").textContent=""; }
}
async function tickMedia(){
  const m = await api("/api/media");
  const box = $("pv-media");
  if (S.media_enabled && m.title){ box.style.display="flex"; placeCorner(box, S.media_pos);
    $("pv-ti").textContent = m.title; $("pv-ar").textContent = m.artist||"";
    $("pv-art").style.backgroundImage = m.art?("url('"+m.art+"')"):"none";
  } else box.style.display="none";
}

function collect(){ FIELDS.forEach(k=>S[k]=getVal(k)); }

function bindLive(){ FIELDS.forEach(k=>{ const el=$(k); el.addEventListener("input",()=>{ collect(); renderPreview(); }); }); }

let pickerTarget = null;
let pickerCurParent = "";
async function pickerLoad(path){
  const d = await (await fetch("/api/files?path="+encodeURIComponent(path))).json();
  pickerCurParent = d.parent;
  $("picker-path").textContent = d.path;
  const list = $("picker-list"); list.innerHTML = "";
  if (d.parent) {
    const up = document.createElement("div");
    up.className = "pick row";
    up.textContent = "⤴  .. (up)";
    up.onclick = ()=>pickerLoad(d.parent);
    list.appendChild(up);
  }
  d.entries.forEach(e=>{
    const el = document.createElement("div");
    el.className = "pick row" + (e.dir ? " dir" : " img");
    el.textContent = (e.dir ? "▸ " : "🖼 ") + e.name;
    el.onclick = async ()=>{
      if (e.dir) { pickerLoad(d.path + "/" + e.name); return; }
      const kind = (pickerTarget === "bg_image") ? "background" : "avatar";
      let finalPath = d.path + "/" + e.name;
      try {
        const r = await api("/api/process-image", "POST", { path: finalPath, kind: kind });
        if (r && r.path) finalPath = r.path;
        if (r && r.upscaled) toast("Image upscaled for " + kind);
      } catch (err) { /* fall back to original path */ }
      $(pickerTarget).value = finalPath;
      collect(); renderPreview(); closePicker();
    };
    list.appendChild(el);
  });
}
function openPicker(t){ pickerTarget = t; $("picker").style.display = "flex"; pickerLoad(""); }
function closePicker(){ $("picker").style.display = "none"; }

async function restorePicker(){
  const list = await api("/api/backups");
  if (!list.length){ toast("No backups yet"); return; }
  const pick = prompt("Restore which backup?\n"+list.map((b,i)=>i+": "+b.file).join("\n"), "0");
  if (pick===null) return;
  const b = list[parseInt(pick)];
  if (!b) return;
  const r = await api("/api/restore","POST",{file:b.file});
  toast(r.ok?"Restored "+b.file:(r.error||"restore failed"));
}

async function refreshRepoStatus(){
  const el = $("repo-status");
  if (!el) return;
  const r = await api("/api/repo-status");
  if (!r.ok){ el.textContent = "project repo: " + (r.error || "unavailable"); return; }
  const bits = [r.branch, r.dirty ? r.dirtyFiles + " uncommitted" : "clean", "last " + r.last];
  if (r.ahead && r.ahead !== "0") bits.push(r.ahead + " ahead");
  el.textContent = "repo: " + r.repo + " · " + bits.join(" · ");
}

async function init(){
  const [theme, settings, media] = await Promise.all([api("/api/theme"), api("/api/settings"), api("/api/media")]);
  THEME = theme; S = settings; applyTheme();
  FIELDS.forEach(k=>setVal(k, S[k]));
  renderPreview(); bindLive(); tick(); setInterval(tick,1000);
  refreshRepoStatus();
  setInterval(tickQuote, (S.quote_interval||12)*1000); tickQuote();
  tickMedia(); setInterval(tickMedia,2000);

  $("bg_browse").onclick = ()=>openPicker("bg_image");
  $("profile_avatar_browse").onclick = ()=>openPicker("profile_avatar");
  $("picker-cancel").onclick = closePicker;
  $("picker-up").onclick = ()=>pickerLoad(pickerCurParent);
  $("apply").onclick = async ()=>{ collect(); const r=await api("/api/apply","POST",S); toast(r.ok?"Applied & restarted shell":("Error: "+(r.error||""))); };
  $("save").onclick = async ()=>{ collect(); const r=await api("/api/settings","POST",S); toast(r.ok?"Saved":"Save failed"); };
  $("backup").onclick = async ()=>{ collect(); const r=await api("/api/apply","POST",S); toast(r.ok?"Backed up & applied":"Error"); };
  $("restore").onclick = restorePicker;
  $("repo").onclick = async ()=>{
    toast("Syncing to project repo…");
    const r = await api("/api/sync-repo","POST",{});
    toast(r.ok ? (r.committed ? "Pushed " + r.commit : "Repo already up to date")
               : ("Sync failed: " + (r.error||"unknown")));
    refreshRepoStatus();
  };
  $("stock").onclick = async ()=>{ if(!confirm("Restore the untouched stock lock screen?")) return; const r=await api("/api/restore-stock","POST",{}); toast(r.ok?"Stock restored":("Error: "+(r.error||""))); };
}
init();
</script>
</body>
</html>
'''

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = urllib.parse.urlparse(self.path).path
        if p == "/" or p == "/index.html":
            self._send(200, HTML.replace("__QUOTES_JSON__", json.dumps(QUOTES)).replace(
                "__FONT_OPTIONS__",
                "".join('<option value="%s">' % f.replace('"', "") for f in installed_fonts())), "text/html")
        elif p == "/api/theme":
            self._send(200, active_theme_colors())
        elif p == "/api/settings":
            self._send(200, load_settings())
        elif p == "/api/media":
            self._send(200, playerctl_snapshot())
        elif p == "/api/backups":
            self._send(200, list_backups())
        elif p == "/api/repo-status":
            self._send(200, repo_status())
        elif p == "/api/files":
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            self._send(200, list_files(q.get("path", [""])[0]))
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        p = urllib.parse.urlparse(self.path).path
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length) if length else b""
        try:
            data = json.loads(raw) if raw else {}
        except Exception:
            data = {}
        plugin = find_plugin_dir()
        lockview = os.path.join(plugin, "LockView.qml") if plugin else None

        if p == "/api/settings":
            save_settings(data)
            self._send(200, {"ok": True})
        elif p == "/api/sync-repo":
            self._send(200, sync_repo())
        elif p == "/api/apply":
            save_settings(data)
            if not lockview:
                self._send(500, {"ok": False, "error": "lock plugin not found"})
                return
            ensure_face_glyph(plugin)
            backup_current(lockview, label="pre-apply")
            try:
                with open(lockview, "w") as f:
                    f.write(render_lockview(data))
            except Exception as e:
                self._send(500, {"ok": False, "error": str(e)})
                return
            ok, err = restart_shell()
            self._send(200, {"ok": ok, "error": err})
        elif p == "/api/restore":
            if not lockview:
                self._send(500, {"ok": False, "error": "lock plugin not found"})
                return
            ok, err = restore_backup(data.get("file", ""), lockview)
            self._send(200, {"ok": ok, "error": err})
        elif p == "/api/restore-stock":
            if not lockview:
                self._send(500, {"ok": False, "error": "lock plugin not found"})
                return
            if not os.path.isfile(INITIAL_BACKUP):
                self._send(500, {"ok": False, "error": "no stock backup"})
                return
            import shutil
            backup_current(lockview, label="pre-stock")
            shutil.copy2(INITIAL_BACKUP, lockview)
            ok, err = restart_shell()
            self._send(200, {"ok": ok, "error": err})
        elif p == "/api/process-image":
            kind = data.get("kind", "background")
            if kind not in ("background", "avatar"):
                kind = "background"
            self._send(200, process_image(data.get("path", ""), kind))
        elif p == "/api/auto-color":
            self._send(200, {"color": readable_text_color(effective_bg(data if data else load_settings()))})
        else:
            self._send(404, {"error": "not found"})

    def log_message(self, *a):
        pass

def main():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    plugin = find_plugin_dir()
    lockview = os.path.join(plugin, "LockView.qml") if plugin else None
    ensure_initial_backup(lockview)
    ensure_face_glyph(plugin)
    if len(sys.argv) > 1 and sys.argv[1] == "--restore-stock":
        if lockview and os.path.isfile(INITIAL_BACKUP):
            import shutil
            backup_current(lockview, label="pre-stock")
            shutil.copy2(INITIAL_BACKUP, lockview)
            ok, err = restart_shell()
            print(("Restored stock. " + err) if ok else ("Failed: " + err))
        else:
            print("Cannot restore stock: plugin/backup not found.")
        return

    if len(sys.argv) > 1 and sys.argv[1] == "--sync-repo":
        r = sync_repo()
        if r.get("ok"):
            print(("Synced: " + r["commit"]) if r.get("committed") else "Project repo already up to date.")
        else:
            print("Sync failed: " + r.get("error", "unknown"))
        return

    no_open = "--no-open" in sys.argv
    url = f"http://127.0.0.1:{PORT}/"
    server = None
    for attempt in range(6):
        try:
            server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
            break
        except OSError:
            if attempt == 0:
                print(f"Port {PORT} in use — taking over the existing instance…")
            free_port(PORT)
            time.sleep(0.5)
    if server is None:
        print(f"Could not bind {PORT}. Opening browser to any existing instance.")
        if not no_open:
            try:
                subprocess.Popen(["firefox", url])
            except Exception:
                try:
                    subprocess.Popen(["xdg-open", url])
                except Exception:
                    pass
        return
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    print(f"Omarchy Lock Studio running at {url}")
    print("Press Ctrl+C to stop.")
    if not no_open:
        try:
            subprocess.Popen(["firefox", url])
        except Exception:
            try:
                subprocess.Popen(["xdg-open", url])
            except Exception:
                print("Could not auto-open firefox; open the URL manually.")
    try:
        while True:
            server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping.")
        server.shutdown()

if __name__ == "__main__":
    main()
